/* 全局样式 */
page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* 通用按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-primary {
  background-color: #5B8C7D;
  color: white;
}

.btn-primary:active {
  background-color: #4A7566;
}

.btn-secondary {
  background-color: #F5F7FA;
  color: #303133;
}

.btn-secondary:active {
  background-color: #E4E7ED;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 容器 */
.container {
  padding: 16px;
  min-height: 100vh;
}

/* 文字颜色 */
.text-primary {
  color: #303133;
}

.text-secondary {
  color: #909399;
}

.text-regular {
  color: #606266;
}

/* 日语字体 */
.jp-text {
  font-family: "Hiragino Kaku Gothic Pro", "Meiryo", "MS Gothic", sans-serif;
}
