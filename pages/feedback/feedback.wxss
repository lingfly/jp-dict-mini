/* pages/feedback/feedback.wxss */
.feedback-page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1px solid #EBEEF5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 15px;
  color: #909399;
  position: relative;
}

.tab-item.active {
  color: #5B8C7D;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 3px;
  background: #5B8C7D;
  border-radius: 2px;
}

/* 提交反馈 */
.create-section {
  padding: 16px;
}

.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 12px;
  display: block;
}

/* 类型选择 */
.type-options {
  display: flex;
  gap: 12px;
}

.type-option {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 8px;
  background: #F5F7FA;
  font-size: 14px;
  color: #606266;
  border: 2px solid transparent;
  transition: all 0.2s;
}

.type-option.selected {
  background: #E8F4F0;
  border-color: #5B8C7D;
  color: #5B8C7D;
  font-weight: 500;
}

/* 标题输入 */
.title-input {
  width: 100%;
  height: 40px;
  font-size: 14px;
  color: #303133;
  padding: 0 12px;
  background: #F5F7FA;
  border-radius: 8px;
  box-sizing: border-box;
}

/* 内容输入 */
.content-textarea {
  width: 100%;
  min-height: 150px;
  font-size: 14px;
  color: #303133;
  line-height: 1.6;
  padding: 12px;
  background: #F5F7FA;
  border-radius: 8px;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 12px;
  color: #C0C4CC;
  margin-top: 8px;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #7BA597, #5B8C7D);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  border-radius: 12px;
  border: none;
  margin-top: 8px;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

/* 反馈列表 */
.list-section {
  padding: 16px;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 48px;
}

.loading-text {
  font-size: 15px;
  color: #909399;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64px 24px;
  text-align: center;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.6;
}

.empty-text {
  font-size: 16px;
  color: #606266;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 13px;
  color: #909399;
}

.feedback-item {
  padding: 16px;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.feedback-type-tag {
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.feedback-type-tag.bug {
  background: #FDECEC;
  color: #E74C3C;
}

.feedback-type-tag.suggestion {
  background: #E8F4F0;
  color: #5B8C7D;
}

.feedback-type-tag.other {
  background: #F0F2F5;
  color: #909399;
}

.feedback-status {
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 500;
  white-space: nowrap;
}

.feedback-status.status-0 {
  background: #FDF6EC;
  color: #E6A23C;
}

.feedback-status.status-1 {
  background: #ECF5FF;
  color: #409EFF;
}

.feedback-status.status-2 {
  background: #E8F4F0;
  color: #67C23A;
}

.feedback-status.status-3 {
  background: #F0F2F5;
  color: #909399;
}

.feedback-content-preview {
  font-size: 14px;
  color: #606266;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
}

.feedback-time {
  font-size: 12px;
  color: #C0C4CC;
}

.feedback-arrow {
  font-size: 13px;
  color: #5B8C7D;
}

.load-more {
  text-align: center;
  padding: 16px;
}

.load-more-text {
  font-size: 14px;
  color: #5B8C7D;
}

/* 反馈详情 */
.detail-section {
  padding: 16px;
}

.detail-content {
  padding-bottom: 16px;
}

.detail-type-row {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
  align-items: center;
}

.detail-time {
  font-size: 12px;
  color: #C0C4CC;
}

.detail-title-text {
  font-size: 16px;
  color: #303133;
  font-weight: 500;
  line-height: 1.5;
}

.detail-text {
  font-size: 14px;
  color: #606266;
  line-height: 1.7;
  white-space: pre-wrap;
}

.detail-reply-card {
  background: #F0F9F4;
  border: 1px solid #C8E6D0;
}

.detail-reply-time {
  font-size: 12px;
  color: #C0C4CC;
  margin-top: 12px;
  display: block;
}

.back-btn-wrap {
  padding: 16px 0;
}

.back-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: #FFFFFF;
  color: #5B8C7D;
  font-size: 15px;
  border-radius: 12px;
  border: 1px solid #5B8C7D;
}
