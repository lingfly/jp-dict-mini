<!--pages/word-detail/word-detail.wxml-->
<wxs module="helper" src="./helper.wxs"></wxs>
<view class="detail-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 单词详情 -->
  <view wx:elif="{{wordDetail}}" class="word-detail">
    <view class="detail-content card">
      <!-- 右上角更多菜单按钮 -->
      <view class="more-btn-wrap">
        <view class="more-btn" bindtap="showCorrectionMenu">
          <view class="more-dot"></view>
          <view class="more-dot"></view>
          <view class="more-dot"></view>
        </view>
        <!-- 弹出菜单 -->
        <view wx:if="{{showMenu}}" class="popup-menu" catchtap="">
          <view class="popup-menu-item" bindtap="goCorrection">
            <text>单词纠错</text>
          </view>
          <view class="popup-menu-item" bindtap="goDefinitionCorrection">
            <text>释义纠错</text>
          </view>
        </view>
      </view>

      <!-- 单词信息 -->
      <view class="word-info">
        <view class="word-main-row">
          <view class="word-title-wrap">
            <text class="word-main jp-text">{{wordDetail.word.kanji || wordDetail.word.kana}}</text>
            <text wx:if="{{wordDetail.word.accent !== null && wordDetail.word.accent !== undefined}}" class="word-accent">{{helper.toCircle(wordDetail.word.accent)}}</text>
          </view>
          <view wx:if="{{wordDetail.wordAudios.length > 0}}" class="audio-btn" data-audio-id="{{wordDetail.wordAudios[0].audioId}}" bindtap="playAudio">
            🔊
          </view>
        </view>
        <text wx:if="{{wordDetail.word.kanji && wordDetail.word.kanji !== wordDetail.word.kana}}" class="word-kana jp-text">{{wordDetail.word.kana}}</text>
        <view class="word-tags">
          <text wx:if="{{wordDetail.word.jlptLevel}}" class="word-tag">{{wordDetail.word.jlptLevel}}</text>
          <text wx:if="{{wordDetail.word.wordType}}" class="word-tag">{{wordDetail.word.wordType}}</text>
        </view>
      </view>

      <!-- 义项列表 -->
      <view wx:if="{{wordDetail.definitions && wordDetail.definitions.length > 0}}" class="sense-list">
        <view
          wx:for="{{wordDetail.definitions}}"
          wx:key="id"
          wx:for-item="definition"
          wx:for-index="defIndex"
          class="sense-card"
        >
          <view class="sense-header" data-index="{{defIndex}}" bindtap="toggleSense">
            <text class="sense-number">{{defIndex + 1}}</text>
            <view class="sense-header-content">
              <text class="sense-title">{{definition.definitionCn}}</text>
            </view>
            <text class="sense-toggle {{helper.includes(expandedSense, defIndex) ? 'expanded' : ''}}">▼</text>
          </view>

          <view wx:if="{{helper.includes(expandedSense, defIndex)}}" class="sense-body">
            <!-- 用法说明 -->
            <view wx:if="{{definition.usage}}" class="sense-usage-wrap">
              <text class="usage-label">用法：</text>
              <text class="sense-usage">{{definition.usage}}</text>
            </view>

            <!-- 例句 -->
            <view wx:if="{{definition.examples && definition.examples.length > 0}}" class="sense-examples">
              <text class="examples-label">例句：</text>
              <view wx:for="{{definition.examples}}" wx:key="id" wx:for-item="example" class="sense-example-item">
                <view class="sense-example-text">
                  <text class="ex-jp jp-text">{{example.sentenceJp}}</text>
                  <text wx:if="{{example.sentenceKana}}" class="ex-kana jp-text">{{example.sentenceKana}}</text>
                  <text class="ex-cn">{{example.sentenceCn}}</text>
                </view>
              </view>
            </view>

            <!-- 注释 -->
            <view wx:if="{{definition.note}}" class="sense-note">
              <text class="note-title">注：</text>
              <text class="note-body">{{definition.note}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>
  </view>
</view>
