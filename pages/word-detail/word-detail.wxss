/* pages/word-detail/word-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 16px;
  padding-bottom: 100px;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80px 0;
  color: #909399;
  font-size: 14px;
}

/* 单词详情 */
.word-detail {
  margin-top: 12px;
}

.detail-content {
  position: relative;
}

/* 更多按钮容器（绝对定位在卡片右上角） */
.more-btn-wrap {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
}

.more-btn {
  width: 32px;
  height: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 6px 4px;
  border-radius: 6px;
}

.more-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #909399;
}

/* 弹出菜单 */
.popup-menu {
  position: absolute;
  top: 0;
  right: 40px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  overflow: hidden;
  white-space: nowrap;
  z-index: 20;
}

.popup-menu-item {
  padding: 10px 16px;
  font-size: 14px;
  color: #303133;
  white-space: nowrap;
}

.popup-menu-item:active {
  background: #F5F7FA;
}

.detail-content {
  padding: 16px;
}

.card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.word-info {
  margin-bottom: 24px;
}

.word-main-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.word-title-wrap {
  display: flex;
  align-items: flex-start;
}

.word-main {
  font-size: 32px;
  font-weight: 700;
  color: #303133;
}

.word-accent {
  font-size: 14px;
  color: #606266;
  margin-left: 4px;
  margin-top: 2px;
  font-weight: 600;
}

.audio-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(91, 140, 125, 0.1);
  font-size: 18px;
}

.word-kana {
  font-size: 16px;
  color: #909399;
  margin-bottom: 8px;
  display: block;
}

.word-tags {
  display: flex;
  gap: 8px;
}

.word-tag {
  padding: 4px 10px;
  background: #F5F7FA;
  color: #606266;
  border-radius: 4px;
  font-size: 12px;
}

/* 义项 */
.sense-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.sense-card {
  border: 1px solid #E4E7ED;
  border-radius: 8px;
  padding: 12px;
}

.sense-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sense-number {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sense-header-content {
  flex: 1;
  min-width: 0;
}

.sense-title {
  flex: 1;
  font-size: 18px;
  font-weight: 600;
  color: #303133;
}

.sense-toggle {
  font-size: 12px;
  color: #909399;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.sense-toggle.expanded {
  transform: rotate(180deg);
}

.sense-body {
  margin-top: 12px;
}

.sense-usage-wrap {
  margin-bottom: 12px;
  line-height: 1.6;
}

.usage-label {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
}

.sense-usage {
  font-size: 16px;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 12px;
  display: block;
}

.sense-examples {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.examples-label {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 8px;
  display: block;
}

.sense-example-item {
  padding: 8px 12px;
  background: #F5F7FA;
  border-radius: 4px;
  border-left: 3px solid #5B8C7D;
}

.sense-example-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.ex-jp {
  font-size: 16px;
  color: #303133;
}

.ex-kana {
  font-size: 12px;
  color: #909399;
}

.ex-cn {
  font-size: 14px;
  color: #606266;
}

.sense-note {
  margin-top: 12px;
  padding: 8px 12px;
  background: rgba(91, 140, 125, 0.1);
  border-left: 3px solid #5B8C7D;
  border-radius: 4px;
}

.note-title {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 4px;
}

.note-body {
  font-size: 14px;
  color: #606266;
  line-height: 1.6;
  display: block;
}

/* 日语字体 */
.jp-text {
  font-family: -apple-system, 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
}

/* ================= 加入词单 ================= */

/* 底部固定按钮 */
.join-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #E9EBF0;
  z-index: 30;
  display: flex;
  gap: 10px;
}

.join-btn {
  flex: 1;
  height: 46px;
  line-height: 46px;
  text-align: center;
  border: 1px solid #5B8C7D;
  color: #5B8C7D;
  background: #fff;
  border-radius: 6px;
  font-size: 13px;
}

/* 收藏按钮（与 home 页 action-btn 样式一致） */
.fav-btn {
  flex: 1;
  height: 46px;
  line-height: 46px;
  text-align: center;
  border: 1px solid #5B8C7D;
  color: #5B8C7D;
  background: #fff;
  border-radius: 6px;
  font-size: 13px;
}

.fav-btn.favorited {
  background: #5B8C7D;
  color: #fff;
}

.fav-btn.disabled {
  opacity: 0.5;
}

/* 弹层容器 */
.join-ov {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.join-mask {
  position: absolute;
  inset: 0;
  background: rgba(16, 20, 28, 0.42);
}

.join-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 18px 18px 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
}

.join-h {
  padding: 14px 16px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.join-h-main {
  flex: 1;
}

.join-t {
  font-size: 16px;
  font-weight: 600;
  color: #14181F;
}

.join-s {
  font-size: 12px;
  color: #8A919D;
  margin-top: 1px;
}

.join-x {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  background: #F2F3F6;
  color: #6B7280;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-b {
  overflow: hidden;
  max-height: 52vh;
}

.join-loading {
  padding: 32px 0;
  text-align: center;
  color: #9AA1AC;
  font-size: 13px;
}

.join-empty {
  padding: 32px 0;
  text-align: center;
  color: #9AA1AC;
  font-size: 13px;
}

.jempty {
  padding: 8px 16px 8px 40px;
  color: #9AA1AC;
  font-size: 12px;
}

/* 词单/分组行 */
.jrow {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 16px;
  position: relative;
}

.jrow + .jrow {
  border-top: 1px solid #F3F4F7;
}

.jrow.sub {
  padding-left: 40px;
}

.jcaret {
  width: 18px;
  height: 18px;
  color: #9AA1AC;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.jcaret.open {
  transform: rotate(90deg);
}

.jcaret-spacer {
  width: 18px;
  flex-shrink: 0;
}

.jbook {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #EEF2FE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}

.jfolder {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  flex-shrink: 0;
}

.jmain {
  flex: 1;
  min-width: 0;
}

.jname {
  font-size: 15px;
  font-weight: 500;
  color: #14181F;
  display: flex;
  align-items: center;
  gap: 6px;
}

.jrow.on .jname {
  color: #5B8C7D;
}

.jmeta {
  font-size: 12px;
  color: #8A919D;
  margin-top: 2px;
}

.jradio {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1.6px solid #CDD1D8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, border-color 0.15s;
}

.jradio.on {
  background: #5B8C7D;
  border-color: #5B8C7D;
}

.jradio-tick {
  color: #fff;
  font-size: 12px;
  line-height: 1;
}

/* 原位置的勾：灰底灰勾，与手动勾选区分 */
.jrow.cur .jradio {
  background: #EFF1F4;
  border-color: #C4C9D2;
}

.jrow.cur .jradio-tick {
  color: #7A828F;
}

/* 底部 */
.join-f {
  padding: 6px 16px 4px;
  border-top: 1px solid #E9EBF0;
}

.jhint {
  font-size: 12px;
  color: #8A919D;
  text-align: center;
  padding: 0 4px 8px;
  line-height: 1.5;
}

.join-go {
  height: 44px;
  border-radius: 12px;
  background: #5B8C7D;
  color: #fff;
  font-size: 15px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-go:active {
  background: #4a7a6c;
}

.join-go.disabled {
  background: #C3CCE8;
}
