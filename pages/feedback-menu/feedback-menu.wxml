<!-- pages/feedback-menu/feedback-menu.wxml -->
<view class="feedback-menu-page">
  <view class="page-title">问题反馈</view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToDevFeedback">
      <view class="menu-left">
        <view class="menu-icon">💬</view>
        <view class="menu-text-group">
          <text class="menu-title">向开发者反馈</text>
          <text class="menu-desc">反馈问题或提出建议</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToComplaint">
      <view class="menu-left">
        <view class="menu-icon">⚠️</view>
        <view class="menu-text-group">
          <text class="menu-title">向微信平台投诉</text>
          <text class="menu-desc">举报违规内容</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
