/* pages/correction-audit-detail/correction-audit-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 16px;
  padding-bottom: 80px;
}

/* 头部 */
.detail-header {
  margin-bottom: 16px;
  padding: 20px 0;
}

.header-kanji {
  font-size: 28px;
  font-weight: 700;
  color: #303133;
  display: block;
}

.header-kana {
  font-size: 16px;
  color: #909399;
  margin-top: 4px;
  display: block;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 12px;
  display: block;
}

/* 对比区域 */
.compare-row {
  display: flex;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #F5F7FA;
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-label {
  width: 56px;
  font-size: 13px;
  color: #909399;
  flex-shrink: 0;
}

.compare-original {
  flex: 1;
  font-size: 14px;
  color: #909399;
  min-width: 0;
  word-break: break-all;
}

.compare-arrow {
  margin: 0 10px;
  color: #C0C4CC;
  font-size: 14px;
  flex-shrink: 0;
}

.compare-correction {
  flex: 1;
  font-size: 14px;
  color: #606266;
  min-width: 0;
  word-break: break-all;
}

.compare-correction.changed {
  color: #67C23A;
  font-weight: 600;
}

/* 纠错说明 */
.remark-text {
  font-size: 14px;
  color: #606266;
  line-height: 1.6;
}

/* 编辑面板 */
.edit-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.edit-toggle .section-title {
  margin-bottom: 0;
}

.edit-arrow {
  font-size: 12px;
  color: #909399;
  transition: transform 0.2s;
}

.edit-arrow.expanded {
  transform: rotate(180deg);
}

.edit-form {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #F5F7FA;
}

.edit-item {
  margin-bottom: 10px;
}

.edit-item:last-child {
  margin-bottom: 0;
}

.edit-label {
  font-size: 13px;
  font-weight: 600;
  color: #606266;
  margin-bottom: 4px;
  display: block;
}

.edit-input {
  width: 100%;
  height: 36px;
  padding: 0 10px;
  background: #F5F7FA;
  border-radius: 4px;
  font-size: 13px;
  box-sizing: border-box;
}

.edit-textarea {
  width: 100%;
  min-height: 60px;
  padding: 8px 10px;
  background: #F5F7FA;
  border-radius: 4px;
  font-size: 13px;
  box-sizing: border-box;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
}

.btn-success {
  background: #5B8C7D;
  color: #fff;
}

.btn-danger {
  background: #F56C6C;
  color: #fff;
}

.btn[disabled] {
  opacity: 0.6;
}
