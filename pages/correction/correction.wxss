/* pages/correction/correction.wxss */
.correction-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 16px;
  padding-bottom: 32px;
}

.page-header {
  margin-bottom: 20px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  color: #303133;
  display: block;
}

.page-subtitle {
  font-size: 14px;
  color: #909399;
  margin-top: 4px;
  display: block;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #909399;
  border-bottom: 2px solid transparent;
  transition: all 0.2s;
}

.type-tab.active {
  color: #5B8C7D;
  border-bottom-color: #5B8C7D;
  font-weight: 600;
}

/* 表单 */
.correction-form {
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  font-size: 14px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 8px;
  display: block;
}

.form-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  background: #F5F7FA;
  border-radius: 6px;
  font-size: 14px;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 80px;
  padding: 10px 12px;
  background: #F5F7FA;
  border-radius: 6px;
  font-size: 14px;
  box-sizing: border-box;
}

/* 释义纠错卡片 */
.def-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.def-card {
  border: 1px solid #E4E7ED;
  border-radius: 8px;
  padding: 12px;
}

.def-header {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 8px;
}

.def-index {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.def-title {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
  flex: 1;
}

.def-usage {
  font-size: 13px;
  color: #909399;
  margin-bottom: 8px;
  padding-left: 30px;
}

.def-textarea {
  width: 100%;
  min-height: 60px;
  padding: 8px 10px;
  background: #F5F7FA;
  border-radius: 6px;
  font-size: 13px;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: #5B8C7D;
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  margin-top: 8px;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

/* 词性下拉多选 */
.word-type-select {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0 12px;
  background: #F5F7FA;
  border-radius: 6px;
  font-size: 14px;
  position: relative;
}

.word-type-placeholder {
  color: #C0C4CC;
  flex: 1;
}

.word-type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  flex: 1;
  padding: 6px 0;
}

.word-type-tag {
  padding: 2px 8px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 4px;
  font-size: 12px;
}

.word-type-arrow {
  font-size: 12px;
  color: #909399;
  flex-shrink: 0;
  margin-left: 8px;
}

.word-type-dropdown {
  margin-top: 4px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.dropdown-scroll {
  max-height: 360px;
}

.dropdown-group {
  border-bottom: 1px solid #F2F3F5;
}

.dropdown-group:last-child {
  border-bottom: none;
}

.dropdown-group-title {
  display: block;
  padding: 10px 14px 6px;
  font-size: 12px;
  font-weight: 600;
  color: #909399;
}

.word-type-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  font-size: 14px;
  color: #303133;
}

.word-type-option:active {
  background: #F5F7FA;
}

.word-type-option.checked {
  color: #5B8C7D;
  font-weight: 500;
}

.option-label {
  flex: 1;
}

.option-check {
  font-size: 14px;
  color: #5B8C7D;
  flex-shrink: 0;
  margin-left: 8px;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  padding: 40px 0;
  color: #909399;
  font-size: 14px;
}
