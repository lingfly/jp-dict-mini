<!-- pages/home/home.wxml -->
<wxs module="helper" src="./helper.wxs"></wxs>
<view class="home-page">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-bar">
      <input
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="输入日语单词，如：ありがとう"
        bindinput="onSearchInput"
        bindconfirm="handleSearch"
      />
      <view class="search-btn" bindtap="handleSearch">查询</view>
    </view>

    <!-- 最近查询 -->
    <view wx:if="{{!wordDetail && searchResults.length === 0 && recentSearches.length > 0}}" class="recent-searches">
      <text class="recent-label">最近查询：</text>
      <text
        wx:for="{{recentSearches}}"
        wx:key="index"
        class="recent-pill"
        data-keyword="{{item}}"
        bindtap="applySearch"
      >{{item}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>查询中...</text>
  </view>

  <!-- 搜索结果列表 -->
  <view wx:elif="{{searchResults.length > 0 && !wordDetail}}" class="search-results">
    <view class="results-header">
      <text class="results-title">{{isAiResult ? 'AI 查词结果' : '找到 ' + searchResults.length + ' 个结果'}}</text>
      <view class="clear-btn" bindtap="clearSearch">✕</view>
    </view>
    <view class="results-list">
      <view
        wx:for="{{searchResults}}"
        wx:key="word.id"
        class="result-item"
        data-index="{{index}}"
        bindtap="selectWord"
      >
        <view class="result-word">
          <!-- kanji 高亮 -->
          <view class="result-main jp-text">
            <text wx:for="{{item._kanjiSegments}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
          </view>
          <!-- kana 高亮 -->
          <view wx:if="{{item.word.kanji && item.word.kanji !== item.word.kana}}" class="result-kana jp-text">
            <text wx:for="{{item._kanaSegments}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
          </view>
        </view>
        <!-- 释义高亮 -->
        <view class="result-meaning">
          <text wx:for="{{item._summaryDef._highlightedCn}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
        </view>
      </view>
    </view>
    <!-- AI 查词入口（仅普通搜索结果下方显示） -->
    <view wx:if="{{!isAiResult}}" class="ai-search-entry ai-search-inline {{aiStreaming ? 'ai-disabled' : ''}}" bindtap="startAiSearch">
      <text wx:if="{{!aiStreaming}}" class="ai-search-icon">✨</text>
      <text wx:else class="ai-search-loading"></text>
      <text class="ai-search-text">{{aiStreaming ? 'AI 查询中...' : 'AI 查词'}}</text>
    </view>
  </view>

  <!-- 无搜索结果 + AI 查词 -->
  <view wx:elif="{{showAiSearch}}" class="ai-search-section">
    <view class="ai-search-header">
      <text class="ai-no-result">未找到匹配单词</text>
    </view>
    <view class="ai-search-entry {{aiStreaming ? 'ai-disabled' : ''}}" bindtap="startAiSearch">
      <text wx:if="{{!aiStreaming}}" class="ai-search-icon">✨</text>
      <text wx:else class="ai-search-loading"></text>
      <text class="ai-search-text">{{aiStreaming ? 'AI 查询中...' : 'AI 查词'}}</text>
    </view>
  </view>

  <!-- 单词详情 -->
  <view wx:elif="{{wordDetail}}" class="word-detail">
    <view class="back-btn" bindtap="backToResults">
      ‹ 返回搜索结果
    </view>

    <view class="detail-content card">
      <!-- 单词信息 -->
      <view class="word-info">
        <view class="word-main-row">
          <view class="word-title-wrap">
            <text class="word-main jp-text">{{wordDetail.word.kanji || wordDetail.word.kana}}</text>
            <text wx:if="{{wordDetail.word.accent !== null && wordDetail.word.accent !== undefined}}" class="word-accent">{{helper.toCircle(wordDetail.word.accent)}}</text>
          </view>
          <view wx:if="{{wordDetail.wordAudios.length > 0}}" class="audio-btn" data-audio-id="{{wordDetail.wordAudios[0].audioId}}" bindtap="playAudio">
            🔊
          </view>
        </view>
        <text wx:if="{{wordDetail.word.kanji && wordDetail.word.kanji !== wordDetail.word.kana}}" class="word-kana jp-text">{{wordDetail.word.kana}}</text>
        <view class="word-tags">
          <text wx:if="{{wordDetail.word.jlptLevel}}" class="word-tag">{{wordDetail.word.jlptLevel}}</text>
          <text wx:if="{{wordDetail.word.wordType}}" class="word-tag">{{wordDetail.word.wordType}}</text>
        </view>
      </view>

      <!-- 义项列表 -->
      <view wx:if="{{wordDetail.definitions && wordDetail.definitions.length > 0}}" class="sense-list">
        <view
          wx:for="{{wordDetail.definitions}}"
          wx:key="id"
          wx:for-item="definition"
          wx:for-index="defIndex"
          class="sense-card"
        >
          <view class="sense-header" data-index="{{defIndex}}" bindtap="toggleSense">
            <text class="sense-number">{{defIndex + 1}}</text>
            <view class="sense-header-content">
              <text class="sense-title">{{definition.definitionCn}}</text>
            </view>
            <text class="sense-toggle {{helper.includes(expandedSense, defIndex) ? 'expanded' : ''}}">▼</text>
          </view>

          <view wx:if="{{helper.includes(expandedSense, defIndex)}}" class="sense-body">
            <!-- 用法说明 -->
            <view wx:if="{{definition.usage}}" class="sense-usage-wrap">
              <text class="usage-label">用法：</text>
              <text class="sense-usage">{{definition.usage}}</text>
            </view>

            <!-- 例句 -->
            <view wx:if="{{definition.examples && definition.examples.length > 0}}" class="sense-examples">
              <text class="examples-label">例句：</text>
              <view wx:for="{{definition.examples}}" wx:key="id" wx:for-item="example" class="sense-example-item">
                <view class="sense-example-text">
                  <text class="ex-jp jp-text">{{example.sentenceJp}}</text>
                  <text wx:if="{{example.sentenceKana}}" class="ex-kana jp-text">{{example.sentenceKana}}</text>
                  <text class="ex-cn">{{example.sentenceCn}}</text>
                </view>
              </view>
            </view>

            <!-- 注释 -->
            <view wx:if="{{definition.note}}" class="sense-note">
              <text class="note-title">注：</text>
              <text class="note-body">{{definition.note}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 操作按钮 — 悬浮底部 -->
  <!-- AI查词结果：反馈按钮 -->
  <view wx:if="{{wordDetail && wordDetail._fromAi}}" class="word-actions">
    <view class="action-btn action-incorrect {{aiFeedbackDone ? 'disabled' : ''}}" bindtap="aiMarkIncorrect">不符合预期</view>
    <view class="action-btn action-correct {{aiFeedbackDone ? 'disabled' : ''}}" bindtap="aiMarkCorrect">符合预期并加入词库</view>
  </view>
  <!-- 普通搜索结果：加入词单/收藏按钮 -->
  <view wx:elif="{{wordDetail}}" class="word-actions">
    <view class="action-btn" bindtap="addToWordlist">加入词单</view>
    <view class="action-btn {{wordDetail.isFavorited ? 'favorited' : ''}}" bindtap="addToReview">
      {{wordDetail.isFavorited ? '已收藏' : '收藏'}}
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-lookup">
    <view class="empty-icon">🔍</view>
    <text class="empty-text">输入日语单词开始查询</text>
  </view>

  <!-- 加入词单弹窗 -->
  <view wx:if="{{showWordListPopup}}" class="popup-mask" bindtap="closeWordListPopup">
    <view class="popup-panel" catchtap="">
      <view class="popup-header">
        <text class="popup-title">加入词单</text>
        <text class="popup-close" bindtap="closeWordListPopup">✕</text>
      </view>
      <scroll-view wx:if="{{myWordLists.length > 0}}" class="popup-list" scroll-y="true">
        <view
          wx:for="{{myWordLists}}"
          wx:key="id"
          class="popup-item {{item.containsWord ? 'checked' : ''}}"
          data-index="{{index}}"
          bindtap="toggleWordListSelect"
        >
          <view class="popup-item-info">
            <text class="popup-item-name">{{item.name}}</text>
            <text class="popup-item-count">{{item.wordCount || 0}} 词</text>
          </view>
          <view class="popup-checkbox {{item.containsWord ? 'checked' : ''}}">
            <text wx:if="{{item.containsWord}}">✓</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="popup-empty">
        <text>暂无我的词单</text>
      </view>
    </view>
  </view>
</view>
