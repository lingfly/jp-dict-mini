// WXS 辅助函数
// 判断数组中是否包含指定元素
function includes(arr, item) {
  if (!arr) return false
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === item) return true
  }
  return false
}

// 数字转圆圈数字 0-10
var circleNums = ['⓪', '①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨', '⑩']
function toCircle(num) {
  if (num >= 0 && num <= 10) return circleNums[num]
  return num
}

// 音调数组转圆圈数字，如 [0,2] → "⓪②"（兼容单个数字）
function toCircleList(list) {
  if (list === null || list === undefined) return ''
  if (list.length === undefined) return '' + toCircle(list)
  var out = ''
  for (var i = 0; i < list.length; i++) {
    var n = list[i]
    out += (n >= 0 && n <= 10) ? circleNums[n] : ('' + n)
  }
  return out
}

module.exports = {
  includes: includes,
  toCircle: toCircle,
  toCircleList: toCircleList
}
