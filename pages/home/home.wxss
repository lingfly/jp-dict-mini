/* pages/home/home.wxss */

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 150;
  background: #fff;
}

.custom-nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  position: relative;
}

.nav-back-btn {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  position: relative;
}

.nav-back-btn::before {
  content: '';
  position: absolute;
  left: 8px;
  top: 50%;
  width: 9px;
  height: 9px;
  border-left: 2px solid #303133;
  border-bottom: 2px solid #303133;
  transform: translateY(-50%) rotate(45deg);
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 17px;
  font-weight: 600;
  color: #303133;
  white-space: nowrap;
}

.nav-placeholder {
  width: 48px;
  flex-shrink: 0;
}

.home-page {
  padding: 16px;
  min-height: 100vh;
}

/* 搜索区 */
.search-section {
  margin-bottom: 16px;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 44px;
  background: white;
  border-radius: 8px;
  padding: 0 4px 0 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 14px;
  height: 44px;
  line-height: 44px;
}

.search-btn {
  padding: 0 10px;
  background: #5B8C7D;
  color: white;
  border-radius: 6px;
  font-size: 13px;
  height: 30px;
  line-height: 30px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recent-searches {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 14px;
}

.recent-label {
  color: #909399;
}

.recent-pill {
  padding: 4px 12px;
  background: white;
  border-radius: 16px;
  color: #606266;
  font-size: 12px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}

/* 加载和空状态 */
.loading-state,
.empty-lookup {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 32px;
  color: #909399;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-text {
  font-size: 14px;
  color: #909399;
}

/* 搜索结果 */
.search-results {
  margin-top: 12px;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.results-title {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
}

.clear-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #909399;
  font-size: 18px;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.result-item {
  background: white;
  border-radius: 8px;
  padding: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.result-word {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 4px;
}

.result-main {
  font-size: 20px;
  font-weight: 700;
  color: #303133;
}

.result-kana {
  font-size: 14px;
  color: #909399;
}

.result-meaning {
  font-size: 14px;
  color: #606266;
  line-height: 1.6;
}

/* 高亮文本 */
.highlight-text {
  color: #E74C3C;
  font-weight: 600;
}

/* 单词详情 */
.word-detail {
  margin-top: 12px;
  padding-bottom: 65px;
}

.detail-content {
  position: relative;
}

/* 更多按钮容器（绝对定位在卡片右上角） */
.more-btn-wrap {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
}

.more-btn {
  width: 32px;
  height: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 6px 4px;
  border-radius: 6px;
}

.more-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #909399;
}

/* 弹出菜单 */
.popup-menu {
  position: absolute;
  top: 0;
  right: 40px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  overflow: hidden;
  white-space: nowrap;
  z-index: 20;
}

.popup-menu-item {
  padding: 10px 16px;
  font-size: 14px;
  color: #303133;
  white-space: nowrap;
}

.popup-menu-item:active {
  background: #F5F7FA;
}

.detail-content {
  padding: 16px;
}

.word-info {
  margin-bottom: 24px;
}

.word-main-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.word-title-wrap {
  display: flex;
  align-items: flex-start;
}

.word-main {
  font-size: 32px;
  font-weight: 700;
  color: #303133;
}

.word-accent {
  font-size: 14px;
  color: #606266;
  margin-left: 4px;
  margin-top: 2px;
  font-weight: 600;
}

.audio-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(91, 140, 125, 0.1);
  font-size: 18px;
}

.word-kana {
  font-size: 16px;
  color: #909399;
  margin-bottom: 8px;
  display: block;
}

.word-tags {
  display: flex;
  gap: 8px;
}

.word-tag {
  padding: 4px 10px;
  background: #F5F7FA;
  color: #606266;
  border-radius: 4px;
  font-size: 12px;
}

/* 义项 */
.sense-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.sense-card {
  border: 1px solid #E4E7ED;
  border-radius: 8px;
  padding: 12px;
}

.sense-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sense-number {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sense-title {
  flex: 1;
  font-size: 18px;
  font-weight: 600;
  color: #303133;
}

.sense-toggle {
  font-size: 12px;
  color: #909399;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.sense-toggle.expanded {
  transform: rotate(180deg);
}

.sense-body {
  margin-top: 12px;
}

.sense-usage {
  font-size: 16px;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 12px;
  display: block;
}

.sense-examples {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sense-example-item {
  padding: 8px 12px;
  background: #F5F7FA;
  border-radius: 4px;
  border-left: 3px solid #5B8C7D;
}

.sense-example-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.ex-jp {
  font-size: 16px;
  color: #303133;
}

.ex-kana {
  font-size: 12px;
  color: #909399;
}

.ex-cn {
  font-size: 14px;
  color: #606266;
}

.sense-note {
  margin-top: 12px;
  padding: 8px 12px;
  background: rgba(91, 140, 125, 0.1);
  border-left: 3px solid #5B8C7D;
  border-radius: 4px;
}

.note-title {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 4px;
}

.note-body {
  font-size: 14px;
  color: #606266;
  line-height: 1.6;
  display: block;
}

/* 操作按钮 */
.word-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 8px;
  padding: 6px 12px;
  background: #F5F7FA;
  box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  text-align: center;
  border: 1px solid #5B8C7D;
  color: #5B8C7D;
  background: white;
  border-radius: 6px;
  font-size: 13px;
}

.action-btn.favorited {
  background: #5B8C7D;
  color: #fff;
}

/* AI 反馈按钮 */
.action-btn.action-incorrect {
  border-color: #E74C3C;
  color: #E74C3C;
  background: white;
}

.action-btn.action-correct {
  border-color: #5B8C7D;
  background: #5B8C7D;
  color: #fff;
}

.action-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 义项头部内容 */
.sense-header-content {
  flex: 1;
  min-width: 0;
}

/* 用法说明 */
.sense-usage-wrap {
  margin-bottom: 12px;
  line-height: 1.6;
}

.usage-label {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
}

/* 例句标签 */
.examples-label {
  font-size: 14px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 8px;
  display: block;
}

/* ===== AI 查词 ===== */
.ai-search-section {
  margin-top: 12px;
  padding: 0 16px;
}

.ai-search-header {
  text-align: center;
  margin-bottom: 16px;
}

.ai-no-result {
  font-size: 15px;
  color: #909399;
}

.ai-search-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  background: #fff;
  border-radius: 12px;
  border: 1.5px dashed #5B8C7D;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.ai-search-inline {
  margin-top: 12px;
}

.ai-search-icon {
  font-size: 20px;
}

.ai-search-text {
  font-size: 16px;
  font-weight: 600;
  color: #5B8C7D;
}

/* AI 查词加载中旋转图标 */
.ai-search-loading {
  width: 20px;
  height: 20px;
  border: 2px solid #E4E7ED;
  border-top-color: #5B8C7D;
  border-radius: 50%;
  animation: ai-spin 0.8s linear infinite;
}

@keyframes ai-spin {
  to { transform: rotate(360deg); }
}

/* AI 查词按钮禁用状态 */
.ai-search-entry.ai-disabled {
  opacity: 0.7;
  pointer-events: none;
}

.ai-loading {
  text-align: center;
  padding: 24px 0;
  color: #909399;
  font-size: 14px;
}

.ai-result {
  margin-top: 12px;
  padding: 16px;
}

.ai-result-header {
  margin-bottom: 8px;
}

.ai-result-title {
  font-size: 15px;
  font-weight: 600;
  color: #5B8C7D;
}

.ai-result-content {
  font-size: 15px;
  color: #303133;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.ai-cursor {
  color: #5B8C7D;
  font-size: 16px;
}

/* AI Markdown 渲染 */
.ai-markdown {
  margin-top: 12px;
  padding: 16px 18px;
}

.ai-md-body {
  line-height: 1.8;
}

.ai-md-br {
  height: 8px;
}

.ai-md-h1 {
  font-size: 20px;
  font-weight: 700;
  color: #303133;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid #F2F3F5;
}

.ai-md-h2 {
  font-size: 18px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 6px;
  margin-top: 12px;
}

.ai-md-h3 {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 4px;
  margin-top: 8px;
}

.ai-md-li {
  display: flex;
  gap: 6px;
  margin-bottom: 4px;
  padding-left: 4px;
  color: #303133;
  font-size: 14px;
}

.ai-md-bullet {
  color: #5B8C7D;
  flex-shrink: 0;
}

.ai-md-p {
  font-size: 14px;
  color: #303133;
  margin-bottom: 4px;
}

/* ===== 加入词单弹窗 ===== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.popup-panel {
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 16px 16px 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 12px;
  border-bottom: 1px solid #F2F3F5;
}

.popup-title {
  font-size: 17px;
  font-weight: 600;
  color: #303133;
}

.popup-close {
  font-size: 18px;
  color: #C0C4CC;
  padding: 4px;
}

.popup-list {
  flex: 1;
  overflow-y: auto;
}

.popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid #F5F7FA;
}

.popup-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.popup-item-info {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.popup-item-name {
  font-size: 15px;
  color: #303133;
}

.popup-item-count {
  font-size: 12px;
  color: #C0C4CC;
}

.popup-checkbox {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid #DCDFE6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: transparent;
  flex-shrink: 0;
}

.popup-checkbox.checked {
  background: #5B8C7D;
  border-color: #5B8C7D;
  color: #fff;
}

.popup-empty {
  display: flex;
  justify-content: center;
  padding: 40px 0;
  color: #909399;
  font-size: 14px;
}
