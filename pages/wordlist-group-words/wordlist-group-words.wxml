<!-- pages/wordlist-group-words/wordlist-group-words.wxml -->
<view class="detail-page">
  <!-- 分组信息条 -->
  <view wx:if="{{group}}" class="group-head">
    <view class="gicon" style="background:{{group.color}}">
      <view class="folder">
        <view class="folder-tab"></view>
        <view class="folder-body"></view>
      </view>
    </view>
    <view class="head-main">
      <view class="head-name">{{group.name}}</view>
      <view class="head-meta">
        <text wx:if="{{group.wordCount === 0}}" class="head-empty">0 个单词 · 空分组</text>
        <text wx:else>{{group.wordCount}} 个单词 · 已掌握 {{group.learnedCount}} 个</text>
      </view>
    </view>
    <view wx:if="{{!selectMode}}" class="more" bindtap="openAction">⋯</view>
    <view wx:else class="more" bindtap="toggleSelectMode">完成</view>
  </view>

  <!-- 单词列表 -->
  <scroll-view class="list-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="sec-header">
      <block wx:if="{{selectMode}}">
        <view class="pick-all" bindtap="onSelectAll">
          <view class="cb small {{allOn ? 'on' : ''}} {{someOn ? 'half' : ''}}">
            <text wx:if="{{allOn}}" class="cb-tick">✓</text>
          </view>
          <text class="pick-text">单词（全选）</text>
        </view>
      </block>
      <block wx:else>
        <text class="sec-title">单词列表</text>
        <text class="sec-count">{{group.wordCount}}</text>
        <text wx:if="{{group.wordCount > 0}}" class="sec-action" bindtap="toggleSelectMode">管理</text>
      </block>
    </view>

    <view class="rows">
      <view wx:if="{{group.wordCount === 0}}" class="blank">
        <view class="blank-box"></view>
        <text class="blank-text">这个分组还是空的</text>
        <text class="blank-sub">右上角「⋯」可从未分组添加单词</text>
      </view>
      <view
        wx:for="{{words}}"
        wx:key="wordId"
        class="row {{selectMode ? 'sel-mode' : ''}}"
        data-id="{{item.wordId}}"
        bindtap="onWordTap"
      >
        <view wx:if="{{selectMode}}" class="cb {{item.selected ? 'on' : ''}}" catchtap="onWordCheck" data-id="{{item.wordId}}">
          <text wx:if="{{item.selected}}" class="cb-tick">✓</text>
        </view>
        <view class="rmain">
          <view class="rname">
            <text class="jp-text">{{item.kanji}}</text>
            <text wx:if="{{item.kana && item.kana !== item.kanji}}" class="ph jp-text">{{item.kana}}</text>
          </view>
          <view wx:if="{{item.meaning}}" class="rmeta">{{item.meaning}}</view>
        </view>
        <view wx:if="{{item.learned}}" class="ok-tag">已掌握</view>
      </view>
    </view>

    <view class="scroll-pad"></view>
  </scroll-view>

  <!-- 多选态底部操作栏 -->
  <view class="bottom-bar {{selectMode ? 'show' : ''}}">
    <view class="sel-cnt">已选 <text class="sel-num">{{selectedCount}}</text></view>
    <view class="bbtn {{selectedCount > 0 ? '' : 'disabled'}}" bindtap="onRemoveFromGroup">
      <text class="bbtn-icon">↩</text><text>移出分组</text>
    </view>
    <view class="bbtn {{selectedCount > 0 ? '' : 'disabled'}}" bindtap="openMove">
      <text class="bbtn-icon">⇄</text><text>移动到…</text>
    </view>
    <view class="bbtn danger {{selectedCount > 0 ? '' : 'disabled'}}" bindtap="openDeleteWords">
      <text class="bbtn-icon">✖</text><text>删除</text>
    </view>
  </view>

  <!-- ===== 快捷菜单 ===== -->
  <view wx:if="{{showAction}}" class="ov">
    <view class="mask" bindtap="closeAction"></view>
    <view class="sheet">
      <view class="sheet-h">
        <view class="sheet-h-main">
          <view class="sheet-t">{{group.name}}</view>
          <view class="sheet-s">{{group.wordCount}} 个单词</view>
        </view>
        <view class="sheet-x" bindtap="closeAction">✕</view>
      </view>
      <view class="sheet-b">
        <view class="opt" data-a="rename" bindtap="onActionTap">
          <view class="opt-icon soft">✎</view>
          <view class="opt-main"><view class="oname">重命名分组</view></view>
        </view>
        <view class="opt" data-a="add" bindtap="onActionTap">
          <view class="opt-icon soft">＋</view>
          <view class="opt-main"><view class="oname">添加单词</view></view>
        </view>
        <view class="opt" data-a="delete" bindtap="onActionTap">
          <view class="opt-icon warn">✖</view>
          <view class="opt-main"><view class="oname danger">删除分组</view></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 移动到分组 ===== -->
  <view wx:if="{{showMove}}" class="ov">
    <view class="mask" bindtap="closeMove"></view>
    <view class="sheet">
      <view class="sheet-h">
        <view class="sheet-h-main">
          <view class="sheet-t">移动到分组</view>
          <view class="sheet-s">将 {{moveCount}} 个单词移动至</view>
        </view>
        <view class="sheet-x" bindtap="closeMove">✕</view>
      </view>
      <scroll-view class="sheet-b" scroll-y="{{true}}">
        <view class="opt {{moveTargetId === '__none' ? 'on' : ''}}" data-t="__none" bindtap="onMoveTargetTap">
          <view class="opt-icon plain">◇</view>
          <view class="opt-main">
            <view class="oname">未分组</view>
            <view class="ometa">移出所有分组</view>
          </view>
          <view class="radio {{moveTargetId === '__none' ? 'on' : ''}}">
            <text wx:if="{{moveTargetId === '__none'}}" class="cb-tick">✓</text>
          </view>
        </view>
        <view
          wx:for="{{moveTargets}}"
          wx:key="id"
          class="opt {{moveTargetId === item.id ? 'on' : ''}}"
          data-t="{{item.id}}"
          bindtap="onMoveTargetTap"
        >
          <view class="opt-icon" style="background:{{item.color}}">
            <view class="folder">
              <view class="folder-tab"></view>
              <view class="folder-body"></view>
            </view>
          </view>
          <view class="opt-main">
            <view class="oname">{{item.name}}</view>
            <view class="ometa">{{item.wordCount}} 个单词</view>
          </view>
          <view class="radio {{moveTargetId === item.id ? 'on' : ''}}">
            <text wx:if="{{moveTargetId === item.id}}" class="cb-tick">✓</text>
          </view>
        </view>
        <view wx:if="{{moveTargets.length === 0}}" class="opt-tip">没有其他分组可选</view>
      </scroll-view>
      <view class="sheet-f">
        <view class="bigbtn {{moveTargetId ? '' : 'disabled'}}" bindtap="confirmMove">移动 {{moveCount}} 个单词</view>
      </view>
    </view>
  </view>

  <!-- ===== 添加单词 ===== -->
  <view wx:if="{{showAdd}}" class="ov">
    <view class="mask" bindtap="closeAdd"></view>
    <view class="sheet">
      <view class="sheet-h">
        <view class="sheet-h-main">
          <view class="sheet-t">添加单词</view>
          <view class="sheet-s">从未分组中选择（共 {{ungrouped.length}} 个）</view>
        </view>
        <view class="sheet-x" bindtap="closeAdd">✕</view>
      </view>
      <scroll-view class="sheet-b" scroll-y="{{true}}">
        <view wx:if="{{ungrouped.length === 0}}" class="blank">
          <view class="blank-box"></view>
          <text class="blank-text">没有未分组的单词了</text>
        </view>
        <view
          wx:for="{{addList}}"
          wx:key="wordId"
          class="opt"
          data-id="{{item.wordId}}"
          bindtap="onAddItemTap"
        >
          <view class="cb {{item.selected ? 'on' : ''}}">
            <text wx:if="{{item.selected}}" class="cb-tick">✓</text>
          </view>
          <view class="opt-main">
            <view class="oname">
              <text class="jp-text">{{item.kanji}}</text>
              <text wx:if="{{item.kana && item.kana !== item.kanji}}" class="ph jp-text">{{item.kana}}</text>
            </view>
            <view wx:if="{{item.meaning}}" class="ometa">{{item.meaning}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-f">
        <view class="bigbtn {{addCount > 0 ? '' : 'disabled'}}" bindtap="confirmAdd">
          {{addCount > 0 ? '加入本分组（' + addCount + '）' : '加入本分组'}}
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 删除确认 ===== -->
  <view wx:if="{{showDelete}}" class="ov">
    <view class="mask" bindtap="closeDelete"></view>
    <view class="dialog">
      <view class="dlg-b">
        <view class="dlg-t">删除</view>
        <view class="dlg-d">
          <block wx:if="{{deleteScope === 'group'}}">
            <text>将删除分组「<text class="b">{{group.name}}</text>」<text wx:if="{{delGroupWords > 0}}">（含 <text class="b">{{delGroupWords}}</text> 个单词）</text>。</text>
          </block>
          <block wx:else>
            <text>将把 <text class="b">{{delWordCount}}</text> 个单词移出词单。</text>
          </block>
        </view>
        <view wx:if="{{deleteScope === 'group' && delGroupWords > 0}}" class="choose">
          <view class="c {{deleteKeepWords ? 'on' : ''}}" data-keep="1" bindtap="onKeepChange">
            <view class="radio {{deleteKeepWords ? 'on' : ''}}">
              <text wx:if="{{deleteKeepWords}}" class="cb-tick">✓</text>
            </view>
            <text>保留单词，移入「未分组」</text>
          </view>
          <view class="c {{!deleteKeepWords ? 'on' : ''}}" data-keep="0" bindtap="onKeepChange">
            <view class="radio {{!deleteKeepWords ? 'on' : ''}}">
              <text wx:if="{{!deleteKeepWords}}" class="cb-tick">✓</text>
            </view>
            <text>同时删除组内单词</text>
          </view>
        </view>
      </view>
      <view class="dlg-f">
        <view class="dlg-btn" bindtap="closeDelete">取消</view>
        <view class="dlg-btn del" bindtap="confirmDelete">删除</view>
      </view>
    </view>
  </view>

  <!-- ===== 重命名 ===== -->
  <view wx:if="{{showRename}}" class="ov">
    <view class="mask" bindtap="closeRename"></view>
    <view class="dialog">
      <view class="dlg-b">
        <view class="dlg-t">重命名分组</view>
        <view class="field">
          <view class="field-label">
            <text>分组名称</text>
            <text class="field-count">{{renameName.length}}/{{nameMax}}</text>
          </view>
          <input
            class="inp"
            value="{{renameName}}"
            maxlength="20"
            placeholder="请输入分组名称"
            placeholder-class="inp-ph"
            focus="{{showRename}}"
            bindinput="onRenameInput"
          />
        </view>
      </view>
      <view class="dlg-f">
        <view class="dlg-btn" bindtap="closeRename">取消</view>
        <view class="dlg-btn pri {{renameValid ? '' : 'disabled'}}" bindtap="confirmRename">保存</view>
      </view>
    </view>
  </view>

  <!-- 轻提示（可撤销） -->
  <view class="toast {{toastShow ? 'show' : ''}}">
    <text class="toast-msg">{{toastMsg}}</text>
    <text wx:if="{{toastUndoable}}" class="toast-undo" bindtap="onUndo">撤销</text>
  </view>
</view>
