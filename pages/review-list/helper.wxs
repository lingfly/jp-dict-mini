// WXS 辅助函数
function includes(arr, item) {
  if (!arr) return false
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === item) return true
  }
  return false
}

function toCircle(num) {
  if (num === null || num === undefined) return ''
  var circleNums = ['⓪', '①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨', '⑩']
  if (num >= 0 && num <= 10) return circleNums[num]
  return '' + num
}

module.exports = {
  includes: includes,
  toCircle: toCircle
}
