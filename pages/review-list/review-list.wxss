/* pages/review-list/review-list.wxss */
.review-page {
  min-height: 100vh;
  padding: 16px;
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 32px;
  color: #909399;
}

/* ===== 空闲状态（开始复习前） ===== */
.idle-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 200px);
}

.idle-card {
  width: 100%;
  max-width: 320px;
  padding: 48px 32px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.idle-icon {
  font-size: 64px;
  margin-bottom: 8px;
}

.idle-title {
  font-size: 18px;
  color: #606266;
}

.idle-count {
  font-size: 56px;
  font-weight: 700;
  color: #5B8C7D;
  line-height: 1.2;
}

.idle-desc {
  font-size: 14px;
  color: #909399;
  margin-bottom: 24px;
}

.start-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  border-radius: 24px;
  font-size: 16px;
}

/* 已完成状态 */
.done-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}

.done-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 3px solid #2F5D50;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42px;
  color: #2F5D50;
}

.done-text {
  font-size: 16px;
  color: #606266;
}

/* ===== 复习中 ===== */
.review-content {
  flex: 1;
  padding-bottom: 80px;
}

/* 单词卡片 */
.word-card {
  padding: 16px;
  text-align: left;
}

.word-question {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 40px 0;
}

.word-question-text {
  font-size: 48px;
  color: #303133;
  font-weight: 600;
}

.word-kana {
  font-size: 32px;
  color: #303133;
  font-weight: 500;
}

.word-tip {
  font-size: 14px;
  color: #909399;
}

/* ===== 答案阶段 - 单词详情 ===== */
.word-answer-detail {
  width: 100%;
}

/* 单词基本信息 */
.word-info {
  margin-bottom: 16px;
}

.word-main-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 6px;
}

.word-title-wrap {
  display: flex;
  align-items: flex-start;
}

.word-main {
  font-size: 28px;
  font-weight: 700;
  color: #303133;
}

.word-accent {
  font-size: 13px;
  color: #606266;
  margin-left: 4px;
  margin-top: 2px;
  font-weight: 600;
}

.audio-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(91, 140, 125, 0.1);
  font-size: 16px;
  flex-shrink: 0;
}

.word-answer-detail .word-kana {
  font-size: 15px;
  color: #909399;
  margin-bottom: 6px;
  display: block;
}

.word-tags {
  display: flex;
  gap: 8px;
}

.word-tag {
  padding: 2px 8px;
  background: #F5F7FA;
  color: #606266;
  border-radius: 4px;
  font-size: 11px;
}

/* 义项列表 */
.sense-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sense-card {
  border: 1px solid #E4E7ED;
  border-radius: 8px;
  padding: 10px;
}

.sense-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sense-number {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sense-header-content {
  flex: 1;
  min-width: 0;
}

.sense-title {
  font-size: 15px;
  font-weight: 600;
  color: #303133;
}

.sense-toggle {
  font-size: 11px;
  color: #909399;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.sense-toggle.expanded {
  transform: rotate(180deg);
}

.sense-body {
  margin-top: 10px;
}

.sense-usage-wrap {
  margin-bottom: 10px;
  line-height: 1.6;
}

.usage-label {
  font-size: 13px;
  font-weight: 600;
  color: #5B8C7D;
}

.sense-usage {
  font-size: 13px;
  color: #606266;
  line-height: 1.6;
}

.sense-examples {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.examples-label {
  font-size: 13px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 4px;
  display: block;
}

.sense-example-item {
  padding: 8px 10px;
  background: #F5F7FA;
  border-radius: 4px;
  border-left: 3px solid #5B8C7D;
}

.sense-example-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.ex-jp {
  font-size: 14px;
  color: #303133;
}

.ex-kana {
  font-size: 11px;
  color: #909399;
}

.ex-cn {
  font-size: 13px;
  color: #606266;
}

.sense-note {
  margin-top: 10px;
  padding: 6px 10px;
  background: rgba(91, 140, 125, 0.1);
  border-left: 3px solid #5B8C7D;
  border-radius: 4px;
}

.note-title {
  font-size: 13px;
  font-weight: 600;
  color: #5B8C7D;
  margin-bottom: 2px;
}

.note-body {
  font-size: 13px;
  color: #606266;
  line-height: 1.6;
  display: block;
}

/* 评分按钮 — 固定悬浮底部 */
.score-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.score-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 12px;
  border-radius: 12px;
  transition: all 0.2s;
}

.score-btn:active {
  transform: scale(0.96);
}

.score-btn.forget {
  background: rgba(245, 108, 108, 0.12);
}

.score-btn.forget:active {
  background: rgba(245, 108, 108, 0.22);
}

.score-btn.vague {
  background: rgba(230, 162, 60, 0.12);
}

.score-btn.vague:active {
  background: rgba(230, 162, 60, 0.22);
}

.score-btn.know {
  background: rgba(103, 194, 58, 0.12);
}

.score-btn.know:active {
  background: rgba(103, 194, 58, 0.22);
}

.score-label {
  font-size: 15px;
  font-weight: 500;
  color: #303133;
}

/* 显示答案按钮 */
.show-answer-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  border-radius: 24px;
  margin-top: 20px;
  font-size: 16px;
}