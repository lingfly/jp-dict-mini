<!--pages/review-list/review-list.wxml-->
<wxs module="helper" src="./helper.wxs"></wxs>
<view class="review-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 加载失败：复用下拉刷新重试 -->
  <view wx:elif="{{loadError}}" class="list-error">
    <text class="list-error-text">{{loadError}}</text>
    <text class="list-error-hint">下拉刷新可重试</text>
  </view>

  <!-- 无复习任务时：今日复习详情（#008）或原有空闲/完成态 -->
  <view wx:elif="{{!currentWord && !loading}}" class="idle-state">
    <!-- 今日复习详情（AC-03）；接口失败时同版式、数值为「—」（AC-04） -->
    <view wx:if="{{todayView}}" class="today-card card">
      <text class="today-date">{{todayView.dateText}}</text>

      <!-- 四档全 0：只说明今天没有复习记录（AC-10） -->
      <view wx:if="{{todayView.empty}}" class="today-empty">
        <text class="today-empty-text">今日暂无复习记录</text>
      </view>

      <block wx:else>
        <view class="today-rows">
          <view wx:for="{{todayView.rows}}" wx:key="key" class="today-row">
            <text class="today-icon">{{item.icon}}</text>
            <view class="today-bar-wrap">
              <view class="today-bar" style="width: {{item.percent}}%; background: {{item.color}};"></view>
            </view>
            <view class="today-row-value">
              <text class="today-row-num">{{item.value}}</text>
              <text class="today-row-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="today-split">
          <view class="today-split-col">
            <text class="today-split-num">{{todayView.newLearned}}</text>
            <text class="today-split-label">新学</text>
          </view>
          <view class="today-split-divider"></view>
          <view class="today-split-col">
            <text class="today-split-num">{{todayView.review}}</text>
            <text class="today-split-label">复习</text>
          </view>
          <view class="today-split-divider"></view>
          <view class="today-split-col">
            <text class="today-split-num">{{todayView.durationText}}</text>
            <text class="today-split-label">时长</text>
          </view>
        </view>

        <text class="today-done">今日复习完成</text>
      </block>
    </view>

    <!-- 详情取数中：只显示加载占位，不闪旧完成页（AC-12） -->
    <view wx:elif="{{todayLoading}}" class="today-loading">
      <text>加载中...</text>
    </view>

    <!-- 极端兜底：due > 0 且详情未就绪时保留「开始复习」入口 -->
    <view wx:elif="{{dueCount > 0}}" class="idle-card card">
      <view class="idle-icon">📚</view>
      <text class="idle-title">今日复习</text>
      <text class="idle-count">{{dueCount}}</text>
      <text class="idle-desc">个单词待复习</text>
      <button class="start-btn btn btn-primary" bindtap="startReview">
        开始复习
      </button>
    </view>
  </view>

  <!-- 复习中 -->
  <view wx:else class="review-content">
    <!-- 单词卡片 -->
    <view class="word-card card">
      <!-- 问题阶段 - 显示汉字 -->
      <view wx:if="{{!showAnswer}}" class="word-question">
        <text selectable="{{true}}" class="word-question-text jp-text">{{currentWord.kanji || currentWord.kana}}</text>
        <text class="word-tip">回忆这个单词的发音和释义</text>
      </view>

      <!-- 答案阶段 - 显示完整单词详情 -->
      <view wx:else class="word-answer-detail">
        <!-- 右上角更多菜单按钮 -->
        <view class="more-btn-wrap">
          <view class="more-btn" bindtap="showCorrectionMenu">
            <view class="more-dot"></view>
            <view class="more-dot"></view>
            <view class="more-dot"></view>
          </view>
          <!-- 弹出菜单 -->
          <view wx:if="{{showMenu}}" class="popup-menu" catchtap="">
            <view class="popup-menu-item" bindtap="goCorrection">
              <text>单词纠错</text>
            </view>
            <view class="popup-menu-item" bindtap="goDefinitionCorrection">
              <text>释义纠错</text>
            </view>
          </view>
        </view>

        <!-- 单词基本信息 -->
        <view class="word-info">
          <view class="word-main-row">
            <view class="word-title-wrap">
              <text selectable="{{true}}" class="word-main jp-text">{{currentWord.kanji || currentWord.kana}}</text>
              <text wx:if="{{currentWord.accent !== null && currentWord.accent !== undefined}}" class="word-accent">{{helper.toCircleList(currentWord.accent)}}</text>
            </view>
            <view wx:if="{{wordDetail.wordAudios && wordDetail.wordAudios.length > 0}}" class="audio-btn">
              🔊
            </view>
          </view>
          <text selectable="{{true}}" wx:if="{{currentWord.kanji && currentWord.kanji !== currentWord.kana}}" class="word-kana jp-text">{{currentWord.kana}}</text>
          <view class="word-tags">
            <text wx:if="{{currentWord.jlptLevel}}" class="word-tag">{{currentWord.jlptLevel}}</text>
            <text wx:if="{{currentWord.wordType}}" class="word-tag">{{currentWord.wordType}}</text>
          </view>
        </view>

        <!-- 义项列表 -->
        <view wx:if="{{wordDetail.definitions && wordDetail.definitions.length > 0}}" class="sense-list">
          <view
            wx:for="{{wordDetail.definitions}}"
            wx:key="id"
            wx:for-item="definition"
            wx:for-index="defIndex"
            class="sense-card"
          >
            <view class="sense-header" data-index="{{defIndex}}" bindtap="toggleSense">
              <text class="sense-number">{{defIndex + 1}}</text>
              <view class="sense-header-content">
                <text selectable="{{true}}" class="sense-title">{{definition.definitionCn}}</text>
              </view>
              <text class="sense-toggle {{helper.includes(expandedSense, defIndex) ? 'expanded' : ''}}">▼</text>
            </view>

            <view wx:if="{{helper.includes(expandedSense, defIndex)}}" class="sense-body">
              <view wx:if="{{definition.usage}}" class="sense-usage-wrap">
                <text class="usage-label">用法：</text>
                <text selectable="{{true}}" class="sense-usage">{{definition.usage}}</text>
              </view>

              <view wx:if="{{definition.examples && definition.examples.length > 0}}" class="sense-examples">
                <text class="examples-label">例句：</text>
                <view wx:for="{{definition.examples}}" wx:key="id" wx:for-item="example" class="sense-example-item">
                  <view class="sense-example-text">
                    <text selectable="{{true}}" class="ex-jp jp-text">{{example.sentenceJp}}</text>
                    <text selectable="{{true}}" wx:if="{{example.sentenceKana}}" class="ex-kana jp-text">{{example.sentenceKana}}</text>
                    <text selectable="{{true}}" class="ex-cn">{{example.sentenceCn}}</text>
                  </view>
                </view>
              </view>

              <view wx:if="{{definition.note}}" class="sense-note">
                <text class="note-title">注：</text>
                <text selectable="{{true}}" class="note-body">{{definition.note}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 下方空白点击区域（问题阶段点击显示答案） -->
    <view wx:if="{{!showAnswer}}" class="blank-tap-area" bindtouchstart="onBlankPress" bindtap="onCardTap">
      <text class="blank-tap-hint">点击空白处显示答案</text>
    </view>
  </view>

  <!-- 提交失败：停留当前卡片，直接再点评分重试 -->
  <view wx:if="{{submitError}}" class="submit-error">{{submitError}}</view>

  <!-- 评分按钮 — 固定悬浮底部；仅在有卡片且已显示答案时出现（AC-RS-66：完成页不提供可点击元素） -->
  <view wx:if="{{showAnswer && currentWord}}" class="score-bar">
    <!-- 按下加深由 hover-class 提供：真机上 :active 会延迟甚至不触发（#006 AC-01） -->
    <!-- 触感绑 touchstart：tap 在 touchend 才派发，会变成"松手才震"（#012） -->
    <view class="score-btn forget" hover-class="score-btn-hover-forget" hover-start-time="0" hover-stay-time="100" bindtouchstart="onScorePress" bindtap="handleScore" data-score="0">
      <text class="score-label">忘记</text>
      <text class="score-next">{{ratingPreviews[0].text}}</text>
    </view>
    <view class="score-btn vague" hover-class="score-btn-hover-vague" hover-start-time="0" hover-stay-time="100" bindtouchstart="onScorePress" bindtap="handleScore" data-score="1">
      <text class="score-label">模糊</text>
      <text class="score-next">{{ratingPreviews[1].text}}</text>
    </view>
    <view class="score-btn know" hover-class="score-btn-hover-know" hover-start-time="0" hover-stay-time="100" bindtouchstart="onScorePress" bindtap="handleScore" data-score="2">
      <text class="score-label">认识</text>
      <text class="score-next">{{ratingPreviews[2].text}}</text>
    </view>
    <view class="score-btn easy" hover-class="score-btn-hover-easy" hover-start-time="0" hover-stay-time="100" bindtouchstart="onScorePress" bindtap="handleScore" data-score="3">
      <text class="score-label">简单</text>
      <text class="score-next">{{ratingPreviews[3].text}}</text>
    </view>
  </view>
</view>