/* pages/review-forecast/review-forecast.wxss */
/* 整页一屏：纵向 flex 占满视口，图表吃掉剩余高度，页面不上下滚动 */
.forecast-page {
  padding: 16px;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
  box-sizing: border-box;
}

/* 图表切换：认知情况 / 新学复习 */
.seg-control {
  display: flex;
  flex: none;
  padding: 4rpx;
  margin-bottom: 12px;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.seg-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #606266;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.seg-item-active {
  background: #5B8C7D;
  color: #FFFFFF;
  font-weight: 600;
}

.chart-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 16px 16px 12px;
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

/* 图表区（纵轴 + 柱区 + 图例）：吃掉卡片内剩余高度 */
.chart-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 图表容器：纵坐标 + 可横向滚动柱状图（高度由 flex 撑开，不再写死 720rpx） */
.chart-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
  margin-top: 12rpx;
}

/* padding-bottom = 横轴标签区高度（.bar-label 的 margin-top 12rpx + height 74rpx），
   保证刻度顶端/底端与绘图区上下沿对齐 */
.y-axis {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding-right: 12rpx;
  padding-bottom: 86rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.y-tick {
  font-size: 18rpx;
  color: #C0C4CC;
  line-height: 1;
}

/* 柱状图滚动区域 */
.chart-scroll {
  flex: 1;
  min-width: 0;
}

/* 柱状图区域：高度由柱区内容决定，列与列等高（标签区固定高度） */
.chart {
  display: flex;
  align-items: flex-start;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* 绘图区：顶部/底部边框 + 中间横线 + 列间竖线。
   height 由页面按「图表区可用高度 − 标签区高度」写入行内样式（一屏不滚动），
   这里的 360rpx 只是量到剩余高度之前的首帧兜底 */
.bar-area {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid #F0F2F5;
  border-bottom: 1rpx solid #F0F2F5;
  border-left: 1rpx solid #F0F2F5;
  background-image: linear-gradient(to bottom, #F0F2F5 1rpx, transparent 1rpx);
  /* 横线间距 = 刻度段数分之一，由页面按实际刻度数写入行内样式（#011）；
     这里的 11.1111%（10 条刻度 / 9 段）只是首帧兜底 */
  background-size: 100% 11.1111%;
  background-repeat: repeat-y;
}

/* 段高由 JS 给百分比；过矮的段用 min-height 兜底可见 */
.bar-seg {
  width: 70%;
  min-width: 4rpx;
  min-height: 4rpx;
}

/* 认知图自下而上：简单(深绿) / 认识(中绿) / 模糊(黄) / 忘记(红) / 待学(灰)
   段与段之间不留圆角：柱顶是动态的最上一段，无法用 CSS 选中，统一直角最稳 */
.seg-easy {
  background: #5B8C7D;
}

.seg-good {
  background: #8FB5A8;
}

.seg-hard {
  background: #E6A23C;
}

.seg-forgot {
  background: #E15A5A;
}

.seg-due {
  background: #C0C4CC;
}

/* 新学复习图自下而上：新学(浅绿) / 复习(深绿) */
.seg-new {
  background: #A8C7BD;
}

.seg-review {
  background: #5B8C7D;
}

/* 横坐标竖排标签：高度写死（2 字与 3 字标签等高），列高才好等分 */
.bar-label {
  margin-top: 12rpx;
  padding-bottom: 8rpx;
  height: 74rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  flex: none;
}

.bar-label-char {
  font-size: 16rpx;
  color: #909399;
  line-height: 1.2;
}

.label-today .bar-label-char {
  color: #5B8C7D;
  font-weight: 600;
}

/* 图例：只说明颜色含义，不放数字 */
.legend {
  flex: none;
  margin-top: 16rpx;
  padding: 0 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.dot-easy {
  background: #5B8C7D;
}

.dot-good {
  background: #8FB5A8;
}

.dot-hard {
  background: #E6A23C;
}

.dot-forgot {
  background: #E15A5A;
}

.dot-due {
  background: #C0C4CC;
}

.dot-new {
  background: #A8C7BD;
}

.dot-review {
  background: #5B8C7D;
}

.legend-text {
  font-size: 22rpx;
  color: #606266;
}

/* 详情卡：常驻，随点击切换；高度固定不参与弹性分配 */
.detail-card {
  flex: none;
  margin-top: 12px;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.detail-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.detail-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.detail-relative {
  font-size: 24rpx;
  color: #909399;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0 8rpx;
}

.detail-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.detail-label {
  font-size: 22rpx;
  color: #909399;
}

.detail-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
  line-height: 1.2;
}

/* 学习时长沿用 .detail-item 的统一样式：与其余 7 项字号/字重/颜色完全一致，
   文案偏长（如「12 分 30 秒」）时用 nowrap 保证单行，避免把 25% 的格子挤成两行 */
.detail-grid .detail-item:last-child .detail-value {
  white-space: nowrap;
}

.detail-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #E6A23C;
  text-align: center;
}

/* 空态 / 错误态 */
.chart-empty {
  padding: 48px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
  color: #909399;
  font-size: 14px;
}

.chart-empty-text {
  font-size: 28rpx;
  color: #909399;
}

.retry-btn {
  width: 200rpx;
  height: 68rpx;
  font-size: 28rpx;
}
