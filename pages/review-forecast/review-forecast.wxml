<!-- pages/review-forecast/review-forecast.wxml -->
<view class="forecast-page">
  <!-- 图表切换：认知情况 / 新学复习（两张图口径一致，共用纵轴，切换不改数值） -->
  <view class="seg-control">
    <view
      class="seg-item {{activeTab === 'cognitive' ? 'seg-item-active' : ''}}"
      bindtap="onSwitchTab"
      data-tab="cognitive"
    >认知情况</view>
    <view
      class="seg-item {{activeTab === 'reviewNew' ? 'seg-item-active' : ''}}"
      bindtap="onSwitchTab"
      data-tab="reviewNew"
    >新学复习</view>
  </view>

  <view class="chart-card card">
    <view wx:if="{{loadState === 'loading'}}" class="chart-empty">加载中...</view>

    <view wx:elif="{{loadState === 'empty'}}" class="chart-empty">暂无学习记录</view>

    <view wx:elif="{{loadState === 'error'}}" class="chart-empty">
      <text class="chart-empty-text">加载失败</text>
      <button class="btn btn-primary retry-btn" bindtap="onRetry">重试</button>
    </view>

    <view wx:else>
      <!-- 图表：左侧纵坐标 + 可横向滚动的柱状图 -->
      <view class="chart-wrap">
        <view class="y-axis">
          <text class="y-tick" wx:for="{{yTicks}}" wx:key="*this">{{item}}</text>
        </view>
        <scroll-view class="chart-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{scrollLeft}}" bindscroll="onChartScroll">
          <view class="chart" style="width: {{chartWidth}}rpx;">
            <!-- 认知情况：简单/认识/模糊/忘记/待学 -->
            <block wx:if="{{activeTab === 'cognitive'}}">
              <view
                class="bar-col {{selectedIndex === index ? 'bar-col-active' : ''}}"
                wx:for="{{barsCognitive}}"
                wx:key="date"
                data-index="{{index}}"
                bindtap="onTapBar"
                style="width: {{barWidth}}rpx;"
              >
                <view class="bar-area">
                  <view class="bar-seg seg-due" wx:if="{{item.dueH > 0}}" style="height: {{item.dueH}}rpx;"></view>
                  <view class="bar-seg seg-forgot" wx:if="{{item.forgotH > 0}}" style="height: {{item.forgotH}}rpx;"></view>
                  <view class="bar-seg seg-hard" wx:if="{{item.hardH > 0}}" style="height: {{item.hardH}}rpx;"></view>
                  <view class="bar-seg seg-good" wx:if="{{item.goodH > 0}}" style="height: {{item.goodH}}rpx;"></view>
                  <view class="bar-seg seg-easy" wx:if="{{item.easyH > 0}}" style="height: {{item.easyH}}rpx;"></view>
                </view>
                <view class="bar-label {{item.isToday ? 'label-today' : ''}}">
                  <text class="bar-label-char" wx:for="{{item.labelChars}}" wx:for-item="ch" wx:key="*this">{{ch}}</text>
                </view>
              </view>
            </block>

            <!-- 新学复习：新学/复习/待学 -->
            <block wx:else>
              <view
                class="bar-col {{selectedIndex === index ? 'bar-col-active' : ''}}"
                wx:for="{{barsReviewNew}}"
                wx:key="date"
                data-index="{{index}}"
                bindtap="onTapBar"
                style="width: {{barWidth}}rpx;"
              >
                <view class="bar-area">
                  <view class="bar-seg seg-due" wx:if="{{item.dueH > 0}}" style="height: {{item.dueH}}rpx;"></view>
                  <view class="bar-seg seg-review" wx:if="{{item.reviewH > 0}}" style="height: {{item.reviewH}}rpx;"></view>
                  <view class="bar-seg seg-new" wx:if="{{item.newH > 0}}" style="height: {{item.newH}}rpx;"></view>
                </view>
                <view class="bar-label {{item.isToday ? 'label-today' : ''}}">
                  <text class="bar-label-char" wx:for="{{item.labelChars}}" wx:for-item="ch" wx:key="*this">{{ch}}</text>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <!-- 图例：只做颜色说明，数字统一由详情卡承担 -->
      <view class="legend">
        <view
          class="legend-item"
          wx:for="{{activeTab === 'cognitive' ? legendCognitive : legendReviewNew}}"
          wx:key="key"
        >
          <view class="legend-dot dot-{{item.key}}"></view>
          <text class="legend-text">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 详情卡：常驻，随点击切换 -->
  <view wx:if="{{loadState === 'ready' && detail}}" class="detail-card card">
    <view class="detail-head">
      <text class="detail-date">{{detail.date}}</text>
      <text class="detail-relative">{{detail.label}}</text>
    </view>

    <view class="detail-grid">
      <view class="detail-item">
        <text class="detail-label">简单</text>
        <text class="detail-value">{{detail.easy}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">认识</text>
        <text class="detail-value">{{detail.good}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">模糊</text>
        <text class="detail-value">{{detail.hard}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">忘记</text>
        <text class="detail-value">{{detail.forgot}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">新学</text>
        <text class="detail-value">{{detail.newLearned}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">复习</text>
        <text class="detail-value">{{detail.review}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">待学</text>
        <text class="detail-value">{{detail.due}}</text>
      </view>
    </view>

    <view class="detail-row">
      <text class="detail-label">学习时长</text>
      <text class="detail-value">{{detail.durationText}}</text>
    </view>

    <view wx:if="{{detail.isFuture}}" class="detail-hint">这一天还没到</view>
  </view>
</view>
