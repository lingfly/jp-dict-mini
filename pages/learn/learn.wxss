/* pages/learn/learn.wxss */
.learn-page {
  min-height: 100vh;
  padding: 16px;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.back-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  font-size: 28px;
  color: #303133;
}

.progress-text {
  display: flex;
  align-items: baseline;
}

.progress-text .current {
  font-size: 20px;
  font-weight: 600;
  color: #5B8C7D;
}

.progress-text .separator {
  color: #C0C4CC;
  margin: 0 4px;
}

.progress-text .total {
  font-size: 16px;
  color: #303133;
}

.type-tag {
  margin-left: auto;
  padding: 4px 12px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 500;
}

.type-tag.success {
  background: rgba(47, 93, 80, 0.1);
  color: #2F5D50;
}

.type-tag.warning {
  background: rgba(196, 30, 58, 0.1);
  color: #C41E3A;
}

.type-tag.primary {
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
}

.type-tag.info {
  background: #F5F7FA;
  color: #909399;
}

.type-tag.danger {
  background: rgba(196, 30, 58, 0.1);
  color: #C41E3A;
}

/* 加载和空状态 */
.loading,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 32px;
  color: #909399;
}

.success-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 3px solid #2F5D50;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48px;
  color: #2F5D50;
  margin-bottom: 24px;
}

.success-title {
  font-size: 24px;
  font-weight: 600;
  color: #303133;
  margin-bottom: 8px;
}

.success-desc {
  font-size: 14px;
  color: #909399;
  margin-bottom: 32px;
}

/* 进度条 */
.progress-bar-wrap {
  height: 6px;
  background: #E4E7ED;
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 16px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7BA597, #5B8C7D);
  border-radius: 3px;
  transition: width 0.3s;
}

/* 提示信息 */
.hint-message {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 16px;
}

.hint-icon {
  font-size: 16px;
}

/* 单词卡片 */
.word-card {
  padding: 48px 24px;
  text-align: center;
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.word-question {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.word-answer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  width: 100%;
}

.word-kana {
  font-size: 36px;
  color: #303133;
  font-weight: 500;
}

.word-text {
  font-size: 48px;
  color: #303133;
  font-weight: 600;
}

.word-meaning {
  font-size: 18px;
  color: #606266;
  line-height: 1.6;
}

.word-example {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #E4E7ED;
  width: 100%;
}

.example-jp {
  font-size: 16px;
  color: #606266;
}

.example-cn {
  font-size: 14px;
  color: #909399;
}

/* 评分按钮 */
.score-buttons {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

.score-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 16px 12px;
  border-radius: 12px;
  transition: all 0.2s;
}

.score-btn.forget {
  background: rgba(245, 108, 108, 0.1);
}

.score-btn.forget:active {
  background: rgba(245, 108, 108, 0.2);
}

.score-btn.vague {
  background: rgba(230, 162, 60, 0.1);
}

.score-btn.vague:active {
  background: rgba(230, 162, 60, 0.2);
}

.score-btn.know {
  background: rgba(103, 194, 58, 0.1);
}

.score-btn.know:active {
  background: rgba(103, 194, 58, 0.2);
}

.score-icon {
  font-size: 32px;
}

.score-text {
  font-size: 14px;
  font-weight: 500;
  color: #303133;
}

/* 显示答案按钮 */
.show-answer-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  margin-top: 16px;
}

/* 统计栏 */
.stats-bar {
  text-align: center;
  margin-top: 16px;
}

.stat-text {
  font-size: 14px;
  color: #909399;
}
