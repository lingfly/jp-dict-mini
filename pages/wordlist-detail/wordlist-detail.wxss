/* pages/wordlist-detail/wordlist-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 16px 100px;
}

/* ===== 三个栏目：未选 / 已选 / 全部 ===== */
.tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  gap: 8px;
  padding: 10px 0;
  background: #F5F7FA;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  border-radius: 10px;
  background: #fff;
  color: #606266;
  font-size: 14px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.tab.active {
  background: #5B8C7D;
  color: #fff;
  font-weight: 600;
}

.tab-name {
  font-size: 14px;
}

.tab-num {
  font-size: 12px;
  opacity: 0.7;
}

.tab.active .tab-num {
  opacity: 0.92;
}

/* ===== 分组分区 ===== */
.word-section {
  display: flex;
  flex-direction: column;
}

.sec {
  margin-bottom: 10px;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 2px;
}

.sec-head.collapsible:active {
  opacity: 0.6;
}

.sec-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex: 0 0 10px;
}

.sec-name {
  font-size: 14px;
  font-weight: 600;
  color: #303133;
}

.sec-count {
  font-size: 12px;
  color: #909399;
}

.sec-chev {
  margin-left: auto;
  width: 20px;
  text-align: center;
  font-size: 18px;
  line-height: 1;
  color: #C0C4CC;
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.sec-chev.up {
  transform: rotate(-90deg);
}

.sec-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* ===== 加载 / 空状态 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80px 0;
  color: #909399;
  font-size: 14px;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding: 80px 0;
}

.empty-text {
  color: #909399;
  font-size: 14px;
}

/* ===== 单词条目 ===== */
.word-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  border-radius: 10px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.word-item.selected {
  background: rgba(91, 140, 125, 0.05);
  border: 1px solid rgba(91, 140, 125, 0.3);
}

/* 定位到目标单词时的高亮脉冲 */
.word-item.flash {
  animation: word-flash 0.8s ease-out 2;
}

@keyframes word-flash {
  0% {
    box-shadow: 0 0 0 0 rgba(91, 140, 125, 0.6);
    background: rgba(91, 140, 125, 0.18);
  }
  100% {
    box-shadow: 0 0 0 10px rgba(91, 140, 125, 0);
    background: rgba(91, 140, 125, 0.05);
  }
}

/* 含选中单词但未展开的分组标题：高亮脉冲提示（不展开分组） */
.sec-head.flash {
  border-radius: 8px;
  animation: sec-flash 0.9s ease-out 2;
}

@keyframes sec-flash {
  0% {
    background: rgba(91, 140, 125, 0.22);
  }
  100% {
    background: rgba(91, 140, 125, 0);
  }
}

/* 勾选框 */
.word-checkbox {
  margin-right: 8px;
  flex-shrink: 0;
}

.checkbox-icon {
  width: 19px;
  height: 19px;
  border-radius: 50%;
  border: 1.5px solid #DCDFE6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: transparent;
  transition: all 0.15s;
}

.checkbox-icon.checked {
  background: #5B8C7D;
  border-color: #5B8C7D;
  color: #fff;
}

.word-checkbox.locked .checkbox-icon {
  background: #C0C4CC;
  border-color: #C0C4CC;
  color: #fff;
}

.word-main {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex: 1;
  min-width: 0;
}

.word-kanji {
  font-size: 15px;
  font-weight: 600;
  color: #303133;
}

.word-kana {
  font-size: 11px;
  color: #C0C4CC;
}

.word-right {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.word-arrow {
  font-size: 16px;
  color: #C0C4CC;
  font-weight: 300;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-actions {
  display: flex;
  gap: 12px;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 500;
}

.bottom-btn.sequential {
  background: #F5F7FA;
  color: #303133;
  border: 1px solid #E4E7ED;
}

.bottom-btn.random {
  background: #F5F7FA;
  color: #303133;
  border: 1px solid #E4E7ED;
}

.bottom-btn.select-words {
  background: #5B8C7D;
  color: #fff;
}

.bottom-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.btn-label {
  font-size: 14px;
}
