<!--pages/wordlist-detail/wordlist-detail.wxml-->
<wxs module="h" src="./helper.wxs"></wxs>
<view class="detail-page">
  <!-- 三个栏目：未选 / 已选 / 全部 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'unselected' ? 'active' : ''}}" data-tab="unselected" bindtap="onTabTap">
      <text class="tab-name">未选</text>
      <text class="tab-num">{{unselectedCount}}</text>
    </view>
    <view class="tab {{activeTab === 'selected' ? 'active' : ''}}" data-tab="selected" bindtap="onTabTap">
      <text class="tab-name">已选</text>
      <text class="tab-num">{{learnedPercent}}%</text>
    </view>
    <view class="tab {{activeTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onTabTap">
      <text class="tab-name">全部</text>
      <text class="tab-num">{{total}}</text>
    </view>
  </view>

  <!-- 单词列表：按分组分区展示 -->
  <view class="word-section">
    <view wx:if="{{loading && sections.length === 0}}" class="loading-state">
      <text>加载中...</text>
    </view>
    <view wx:elif="{{sections.length === 0}}" class="empty-state">
      <text class="empty-text">暂无单词</text>
    </view>
    <block wx:else>
      <view wx:for="{{sections}}" wx:for-item="sec" wx:key="id" class="sec">
        <!-- 分组表头（可下拉展开 / 收起）；未分组表头固定展开 -->
        <view
          class="sec-head {{sec.isGroup ? 'collapsible' : ''}} {{h.has(flashGroupIds, sec.id) ? 'flash' : ''}}"
          data-id="{{sec.id}}"
          bindtap="onToggleGroup"
        >
          <view class="sec-dot" style="background:{{sec.color}}"></view>
          <text class="sec-name">{{sec.name}}</text>
          <text class="sec-count">{{sec.count}}</text>
          <view wx:if="{{sec.isGroup}}" class="sec-chev {{sec.expanded ? 'up' : ''}}">›</view>
        </view>

        <view wx:if="{{sec.expanded}}" class="sec-body">
          <view
            wx:for="{{sec.words}}"
            wx:for-item="item"
            wx:key="wordId"
            id="word-{{item.wordId}}"
            class="word-item card {{h.has(selectedWordIds, item.wordId) || item.learningStatus === 'learning' ? 'selected' : ''}} {{h.has(flashWordIds, item.wordId) ? 'flash' : ''}}"
            data-word-id="{{item.wordId}}"
            bindtap="goWordDetail"
          >
            <view class="word-checkbox {{item.learningStatus === 'learning' ? 'locked' : ''}}" catchtap="onCheckboxTap" data-word-id="{{item.wordId}}">
              <view class="checkbox-icon {{h.has(selectedWordIds, item.wordId) || item.learningStatus === 'learning' ? 'checked' : ''}}">
                <text wx:if="{{h.has(selectedWordIds, item.wordId) || item.learningStatus === 'learning'}}">✓</text>
              </view>
            </view>
            <view class="word-main">
              <text class="word-kanji jp-text">{{item.kanji}}</text>
              <text wx:if="{{item.kana && item.kana !== item.kanji}}" class="word-kana jp-text">{{item.kana}}</text>
            </view>
            <view class="word-right">
              <view class="word-arrow">›</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-actions">
      <view class="bottom-btn sequential" bindtap="startSequentialLearn">
        <text class="btn-label">顺序</text>
      </view>
      <view class="bottom-btn random" bindtap="startRandomLearn">
        <text class="btn-label">随机</text>
      </view>
      <view class="bottom-btn select-words {{submitting ? 'disabled' : ''}}" bindtap="onThirdBtnTap">
        <text class="btn-label">
          <text wx:if="{{selectedWordIds.length > 0}}">加入学习 {{displayLearnedCount}}/{{learningStatus.dailyNewWords || 20}}</text>
          <text wx:else>今日待选 {{displayLearnedCount}}/{{learningStatus.dailyNewWords || 20}}</text>
        </text>
      </view>
    </view>
  </view>
</view>
