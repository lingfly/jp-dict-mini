<!-- pages/correction-audit/correction-audit.wxml -->
<view class="audit-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state card">
    <view class="loading-icon">⏳</view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 纠错审核列表 -->
  <view wx:else class="audit-content">
    <view wx:if="{{list.length === 0}}" class="empty-state card">
      <text class="empty-text">暂无待审核的纠错</text>
    </view>

    <view wx:for="{{list}}" wx:key="id" class="audit-card card">
      <view class="audit-header">
        <text class="word-kanji">{{item.kanji || item.word}}</text>
        <text wx:if="{{item.kana}}" class="word-kana">{{item.kana}}</text>
      </view>

      <!-- 纠错内容对比 -->
      <view class="compare-section">
        <view class="compare-row">
          <text class="compare-label">原文：</text>
          <text class="compare-content old">{{item.originalContent || '-'}}</text>
        </view>
        <view class="compare-row">
          <text class="compare-label">建议：</text>
          <text class="compare-content new">{{item.suggestedContent || '-'}}</text>
        </view>
        <view class="compare-row">
          <text class="compare-label">字段：</text>
          <text class="compare-content">{{item.field || '-'}}</text>
        </view>
        <view wx:if="{{item.reason}}" class="compare-row">
          <text class="compare-label">原因：</text>
          <text class="compare-content">{{item.reason}}</text>
        </view>
      </view>

      <view class="audit-actions">
        <button class="btn btn-success" bindtap="approve" data-id="{{item.id}}">通过</button>
        <button class="btn btn-danger" bindtap="reject" data-id="{{item.id}}">拒绝</button>
      </view>
    </view>
  </view>
</view>
