<!--pages/correction-audit/correction-audit.wxml-->
<view class="audit-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 纠错审核列表 -->
  <view wx:else class="audit-content">
    <view wx:if="{{list.length === 0}}" class="empty-state card">
      <text class="empty-text">暂无待审核的纠错</text>
    </view>

    <view
      wx:for="{{list}}"
      wx:key="id"
      wx:for-item="item"
      wx:for-index="idx"
      class="audit-card card"
      data-index="{{idx}}"
      bindtap="goDetail"
    >
      <view class="audit-word">
        <text class="word-kanji">{{item.wordKanji}}</text>
        <text wx:if="{{item.wordKana}}" class="word-kana">{{item.wordKana}}</text>
      </view>
      <view class="audit-summary">
        <text wx:if="{{item.correctionKanji && item.correctionKanji !== item.wordKanji}}" class="change-tag">汉字</text>
        <text wx:if="{{item.correctionKana && item.correctionKana !== item.wordKana}}" class="change-tag">假名</text>
        <text wx:if="{{item.correctionAccent != null && item.correctionAccent !== item.wordAccent}}" class="change-tag">音调</text>
        <text wx:if="{{item.correctionWordType && item.correctionWordType !== item.wordWordType}}" class="change-tag">词性</text>
      </view>
      <view class="audit-arrow">›</view>
    </view>
  </view>
</view>
