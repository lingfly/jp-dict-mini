<!-- pages/login/login.wxml -->
<view class="login-container">
  <view class="login-card">
    <!-- Logo 和标题 -->
    <view class="login-header">
      <view class="logo">📚</view>
      <text class="title">日语词典</text>
      <text class="subtitle">科学记忆，高效学习</text>
    </view>

    <!-- 功能介绍 -->
    <view class="features">
      <view class="feature-item">
        <text class="feature-icon">🔍</text>
        <text class="feature-text">查词</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">📚</text>
        <text class="feature-text">词单</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">📖</text>
        <text class="feature-text">复习</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">📊</text>
        <text class="feature-text">统计</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-btn"
      loading="{{loading}}"
      bindtap="handleWechatLogin"
    >
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>

    <!-- 游客模式 -->
    <view class="guest-link" bindtap="skipLogin">
      <text>暂不登录，先看看</text>
    </view>

    <!-- 隐私提示 -->
    <view class="privacy-text">
      <text>登录即表示同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>
