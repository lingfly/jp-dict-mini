/* pages/correction-definition-audit-detail/correction-definition-audit-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 16px;
  padding-bottom: 100px;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 80px 0;
  color: #909399;
  font-size: 14px;
}

.card {
  background: #fff;
  border-radius: 8px;
  margin-bottom: 10px;
  padding: 14px 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* 头部 */
.detail-header {
  margin-bottom: 16px;
  padding: 0 4px;
}

.header-kanji {
  font-size: 22px;
  font-weight: 700;
  color: #303133;
}

.header-kana {
  font-size: 15px;
  color: #909399;
  margin-left: 10px;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #303133;
  display: block;
  margin-bottom: 10px;
}

/* 元信息 */
.meta-row {
  display: flex;
  margin-bottom: 6px;
}

.meta-label {
  font-size: 13px;
  color: #909399;
  width: 80px;
  flex-shrink: 0;
}

.meta-value {
  font-size: 13px;
  color: #303133;
}

/* ===== 纠错明细（只读展示） ===== */
.ci-card {
  border: 1px solid #E4E7ED;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 12px;
  background: #FAFBFC;
}

.ci-card:last-child {
  margin-bottom: 0;
}

.ci-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 12px;
}

.op-tag {
  padding: 0px 6px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1.6;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.op-add {
  background: rgba(103, 194, 58, 0.1);
  color: #67C23A;
}

.op-update {
  background: rgba(230, 162, 60, 0.1);
  color: #E6A23C;
}

.op-delete {
  background: rgba(245, 108, 108, 0.1);
  color: #F56C6C;
}

.ci-title {
  font-size: 14px;
  font-weight: 600;
  color: #303133;
  flex: 1;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.ci-body {
  padding-left: 4px;
}

/* 对比展示块 */
.compare-block {
  margin-bottom: 16px;
  padding: 10px;
  background: #FFFFFF;
  border-radius: 6px;
}

.compare-block:last-child {
  margin-bottom: 0;
}

.def-label {
  font-size: 13px;
  font-weight: 600;
  color: #606266;
  display: block;
  margin-bottom: 8px;
}

.compare-item {
  margin-bottom: 8px;
  padding: 10px;
  border-radius: 6px;
}

.compare-item:last-child {
  margin-bottom: 0;
}

.compare-item.original {
  background: rgba(245, 108, 108, 0.08);
}

.compare-item.modified {
  background: rgba(103, 194, 58, 0.08);
}

.compare-marker {
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
}

.compare-item.original .compare-marker {
  color: #F56C6C;
}

.compare-item.modified .compare-marker {
  color: #67C23A;
}

.compare-content {
  padding-left: 12px;
}

.compare-text {
  font-size: 14px;
  color: #303133;
  line-height: 1.6;
  display: block;
}

.example-jp {
  font-size: 14px;
  color: #303133;
  line-height: 1.6;
  display: block;
  margin-bottom: 4px;
}

.example-cn {
  font-size: 13px;
  color: #606266;
  line-height: 1.5;
  display: block;
}

/* 删除块 */
.def-block {
  margin-bottom: 16px;
  padding: 10px;
  background: #FFFFFF;
  border-radius: 6px;
}

.def-block:last-child {
  margin-bottom: 0;
}

.delete-block {
  background: rgba(245, 108, 108, 0.08);
}

.add-block {
  background: rgba(103, 194, 58, 0.05);
}

.def-content {
  padding-left: 12px;
}

.def-text {
  font-size: 14px;
  color: #303133;
  line-height: 1.6;
  display: block;
}

.def-hint {
  font-size: 12px;
  color: #909399;
  display: block;
  margin-top: 6px;
  font-style: italic;
}

/* 字段行 */
.field-row {
  margin-bottom: 6px;
  display: flex;
  line-height: 1.6;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 13px;
  color: #909399;
  flex-shrink: 0;
  min-width: 48px;
}

.field-value {
  font-size: 14px;
  color: #303133;
  flex: 1;
}

.example-kana {
  font-size: 13px;
  color: #909399;
  line-height: 1.5;
  display: block;
  margin-bottom: 4px;
}

/* 例句列表 */
.examples-list {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #E4E7ED;
}

.examples-title {
  font-size: 13px;
  font-weight: 600;
  color: #606266;
  display: block;
  margin-bottom: 8px;
}

.example-item {
  margin-bottom: 10px;
  padding: 8px 10px;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 6px;
}

.example-item:last-child {
  margin-bottom: 0;
}

.example-index {
  font-size: 12px;
  color: #909399;
  display: block;
  margin-bottom: 4px;
}

/* 注释文本 */
.note-text {
  font-size: 12px;
  color: #909399;
  line-height: 1.5;
  margin-top: 12px;
  padding: 8px 12px;
  background: #F5F7FA;
  border-radius: 6px;
}

.empty-mini {
  text-align: center;
  color: #909399;
  font-size: 13px;
  padding: 16px 0;
}

/* 拒绝原因 */
.reject-section {
  border: 1px solid #F56C6C;
}

.reject-textarea {
  width: 100%;
  min-height: 80px;
  padding: 10px 12px;
  background: #F5F7FA;
  border-radius: 6px;
  font-size: 14px;
  box-sizing: border-box;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.action-btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
}

.action-btn.disabled {
  opacity: 0.6;
}

.btn-success {
  background: #5B8C7D;
}

.btn-danger {
  background: #F56C6C;
}

.btn-cancel {
  background: #909399;
}
