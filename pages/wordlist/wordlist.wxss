/* pages/wordlist/wordlist.wxss */
.wordlist-page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* ===== 搜索框 ===== */
.search-section {
  padding: 16px;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24px;
  padding: 0 16px;
  height: 44px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  font-size: 14px;
  height: 44px;
}

.search-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

/* ===== 分类横向滚动 ===== */
.category-section {
  padding: 0 0 12px;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-list {
  display: inline-flex;
  gap: 8px;
  padding: 0 16px;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  background: #fff;
  border-radius: 20px;
  font-size: 13px;
  color: #606266;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.category-item.active {
  background: #5B8C7D;
  color: #fff;
  font-weight: 500;
}

/* ===== 词单列表 ===== */
.wordlist-container {
  padding: 0 16px 24px;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 0;
  color: #909399;
  font-size: 14px;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 0;
}

.empty-text {
  color: #909399;
  font-size: 14px;
}

.wordlist-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ===== 分区标题 ===== */
.current-section {
  margin-bottom: 8px;
}

.section-title {
  display: block;
  font-size: 13px;
  color: #909399;
  margin-bottom: 8px;
  padding-left: 4px;
}

/* ===== 词单卡片 ===== */
.wordlist-card {
  padding: 16px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.wordlist-card.current {
  border: 1.5px solid #5B8C7D;
}

.wordlist-main {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wordlist-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.wordlist-name {
  font-size: 17px;
  font-weight: 600;
  color: #303133;
}

.wordlist-category {
  font-size: 11px;
  padding: 2px 8px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 10px;
  flex-shrink: 0;
}

.wordlist-desc {
  font-size: 13px;
  color: #909399;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.wordlist-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wordlist-count {
  font-size: 12px;
  color: #C0C4CC;
}

.current-tag {
  font-size: 11px;
  padding: 2px 8px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 10px;
}

/* ===== 操作按钮 ===== */
.wordlist-action {
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
}

.select-btn {
  padding: 6px 18px;
  background: #5B8C7D;
  color: #fff;
  border-radius: 16px;
  font-size: 13px;
}

.selected-btn {
  padding: 6px 18px;
  background: #F5F7FA;
  color: #5B8C7D;
  border-radius: 16px;
  font-size: 13px;
  border: 1px solid #5B8C7D;
}
