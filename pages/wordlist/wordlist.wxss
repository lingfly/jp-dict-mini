/* pages/wordlist/wordlist.wxss */
.header {
  margin-bottom: 16px;
}

.page-title {
  font-size: 24px;
  font-weight: 600;
  color: #303133;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48px 0;
  color: #909399;
}

.wordlist-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.wordlist-item {
  padding: 16px;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
}

.wordlist-item.active {
  border: 2px solid #5B8C7D;
}

.wordlist-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wordlist-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wordlist-name {
  font-size: 18px;
  font-weight: 600;
  color: #303133;
}

.current-badge {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: #5B8C7D;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.wordlist-desc {
  font-size: 14px;
  color: #606266;
  line-height: 1.5;
}

.wordlist-count {
  font-size: 12px;
  color: #909399;
}

.select-btn-wrap {
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
}

.select-btn {
  padding: 6px 20px;
  background-color: #5B8C7D;
  color: white;
  border-radius: 16px;
  font-size: 14px;
}
