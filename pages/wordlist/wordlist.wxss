/* pages/wordlist/wordlist.wxss */
.wordlist-page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* ===== 搜索框 ===== */
.search-section {
  padding: 16px;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24px;
  padding: 0 16px;
  height: 44px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  font-size: 14px;
  height: 44px;
}

.search-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

/* ===== 分类横向滚动 ===== */
.category-section {
  padding: 0 0 12px;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-list {
  display: inline-flex;
  gap: 8px;
  padding: 0 16px;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  background: #fff;
  border-radius: 20px;
  font-size: 13px;
  color: #606266;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.category-item.active {
  background: #5B8C7D;
  color: #fff;
  font-weight: 500;
}

/* ===== 词单列表 ===== */
.wordlist-container {
  padding: 0 16px 24px;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 0;
  color: #909399;
  font-size: 14px;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 0;
}

.empty-text {
  color: #909399;
  font-size: 14px;
}

.wordlist-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ===== 分区标题 ===== */
.current-section {
  margin-bottom: 8px;
}

.section-title {
  display: block;
  font-size: 13px;
  color: #909399;
  margin-bottom: 8px;
  padding-left: 4px;
}

/* ===== 词单卡片 ===== */
.wordlist-card {
  position: relative;
  padding: 16px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  /* 覆盖全局 .card 的 overflow: hidden，避免裁剪弹出的菜单 */
  overflow: visible;
}

/* 展开"更多"菜单的卡片，提升层级避免被下方卡片遮挡 */
.wordlist-card.menu-open {
  z-index: 200;
}

.wordlist-card.current {
  border: 1.5px solid #5B8C7D;
}

.wordlist-main {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wordlist-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* "更多"按钮（右上角） */
.more-wrap {
  position: relative;
  margin-left: auto;
  flex-shrink: 0;
}

.more-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
  color: #909399;
  border-radius: 50%;
}

.more-btn:active {
  background: #F5F7FA;
}

/* 弹出小菜单（按钮下方右对齐） */
.pop-menu {
  position: absolute;
  top: 40px;
  right: 0;
  min-width: 150px;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  padding: 6px 0;
  z-index: 100;
}

.pop-item {
  padding: 12px 18px;
  font-size: 14px;
  color: #303133;
  white-space: nowrap;
}

.pop-item:active {
  background: #F5F7FA;
}

.pop-item.danger {
  color: #E64340;
}

/* 点击空白处关闭菜单的透明遮罩 */
.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.wordlist-name {
  font-size: 17px;
  font-weight: 600;
  color: #303133;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wordlist-category {
  font-size: 11px;
  padding: 2px 8px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 10px;
  flex-shrink: 0;
}

.wordlist-desc {
  font-size: 13px;
  color: #909399;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.wordlist-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wordlist-count {
  font-size: 12px;
  color: #C0C4CC;
}

.current-tag {
  font-size: 11px;
  padding: 2px 8px;
  background: rgba(91, 140, 125, 0.1);
  color: #5B8C7D;
  border-radius: 10px;
}

/* "已收藏"标签（与"当前使用"相同样式） */
.favorite-tag {
  font-size: 11px;
  padding: 2px 8px;
  background: rgba(247, 186, 42, 0.12);
  color: #E6A23C;
  border-radius: 10px;
}

.bottom-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ===== 操作按钮 ===== */
.wordlist-action {
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
}

.select-btn {
  padding: 6px 18px;
  background: #5B8C7D;
  color: #fff;
  border-radius: 16px;
  font-size: 13px;
}

.selected-btn {
  padding: 6px 18px;
  background: #F5F7FA;
  color: #5B8C7D;
  border-radius: 16px;
  font-size: 13px;
  border: 1px solid #5B8C7D;
}

/* ===== 右下角浮动创建按钮 ===== */
.fab-create {
  position: fixed;
  right: 24px;
  bottom: 48px;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #5B8C7D;
  color: #fff;
  font-size: 28px;
  line-height: 52px;
  text-align: center;
  box-shadow: 0 4px 12px rgba(91, 140, 125, 0.4);
  z-index: 10;
}

.fab-create:active {
  background: #4a7a6b;
}

/* ===== 创建词单弹窗 ===== */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.dialog {
  width: 80%;
  background: #fff;
  border-radius: 16px;
  padding: 24px 20px 20px;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 17px;
  font-weight: 600;
  color: #303133;
  text-align: center;
  margin-bottom: 20px;
}

.dialog-input {
  height: 44px;
  background: #F5F7FA;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
}

.dialog-placeholder {
  color: #C0C4CC;
}

.dialog-textarea {
  width: 100%;
  min-height: 72px;
  background: #F5F7FA;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  margin-top: 12px;
  box-sizing: border-box;
}

.dialog-picker {
  margin-top: 12px;
}

.dialog-public-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  margin-top: 12px;
  padding: 0 4px;
}

.dialog-public-label {
  font-size: 14px;
  color: #606266;
}

.dialog-switch {
  transform: scale(0.85);
}

.dialog-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  background: #F5F7FA;
  border-radius: 8px;
  padding: 0 12px;
}

.dialog-picker-label {
  font-size: 14px;
  color: #606266;
}

.dialog-picker-value {
  font-size: 14px;
  color: #909399;
}

.dialog-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.dialog-btn {
  flex: 1;
  height: 42px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.dialog-btn.cancel {
  background: #F5F7FA;
  color: #606266;
}

.dialog-btn.confirm {
  background: #5B8C7D;
  color: #fff;
}

.dialog-btn:active {
  opacity: 0.85;
}
