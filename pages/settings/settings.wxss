/* pages/settings/settings.wxss */
.settings-page {
  padding: 16px;
  min-height: 100vh;
  background: #F5F7FA;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 48px;
}

.loading-text {
  font-size: 16px;
  color: #909399;
}

.settings-content {
  background: #FFFFFF;
  border-radius: 12px;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid #F5F7FA;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.setting-title {
  font-size: 16px;
  color: #303133;
  font-weight: 500;
}

.setting-desc {
  font-size: 13px;
  color: #909399;
}

.setting-control {
  flex-shrink: 0;
  margin-left: 16px;
}

/* 每日新词数量输入 */
.number-input {
  width: 60px;
  height: 36px;
  border: 1px solid #DCDFE6;
  border-radius: 6px;
  text-align: center;
  font-size: 16px;
  color: #303133;
  background: #FFFFFF;
  padding: 0 8px;
}

.setting-unit {
  font-size: 13px;
  color: #909399;
  margin-left: 6px;
}

/* 管理员配置区域 */
.admin-section {
  margin-top: 16px;
  background: #FFFFFF;
  border-radius: 12px;
  overflow: hidden;
}

.section-title {
  padding: 12px 20px;
  font-size: 14px;
  font-weight: 600;
  color: #606266;
  background: #F5F7FA;
  border-bottom: 1px solid #E4E7ED;
}

/* 模型选择器 */
.model-selector {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #F5F7FA;
  border-radius: 6px;
  min-width: 140px;
}

.model-value {
  font-size: 14px;
  color: #303133;
  flex: 1;
}

.model-arrow {
  font-size: 18px;
  color: #C0C4CC;
}

/* 选择器弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 12px 12px 0 0;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid #E4E7ED;
}

.picker-title {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
}

.picker-cancel,
.picker-confirm {
  font-size: 15px;
  color: #5B8C7D;
  padding: 4px 8px;
}

.picker-view {
  height: 240px;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #303133;
  height: 48px;
}
