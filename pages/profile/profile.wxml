<!-- pages/profile/profile.wxml -->
<view class="profile-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state card">
    <view class="loading-icon">⏳</view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 已登录状态 -->
  <view wx:elif="{{isLoggedIn}}" class="profile-content">
    <!-- 用户信息卡片 -->
    <view class="user-card card">
      <view class="user-info">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-placeholder">
          <text class="avatar-initial">{{userInfo.nickname ? userInfo.nickname[0] : (userInfo.username ? userInfo.username[0] : '?')}}</text>
        </view>
        <view class="user-details">
          <text class="username">{{userInfo.nickname || userInfo.username}}</text>
          <text class="user-email">{{userInfo.email || 'ID: ' + userInfo.id}}</text>
        </view>
      </view>
    </view>

    <!-- 学习统计 -->
    <view class="stats-card card" bindtap="goToReviewForecast">
      <view class="stats-header">
        <text class="card-title">学习统计</text>
        <text class="stats-arrow">›</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{learningStats.learnedWords}}</text>
          <text class="stat-label">已学习</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{learningStats.masteredWords}}</text>
          <text class="stat-label">已掌握</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{learningStats.dailyNewWords}}</text>
          <text class="stat-label">每日目标</text>
        </view>
      </view>
    </view>

    <!-- 学习设置菜单 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">学习设置</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 我的纠错 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="goToMyCorrection">
        <view class="menu-left">
          <text class="menu-icon">✏️</text>
          <text class="menu-text">我的纠错</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 问题反馈 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-left">
          <text class="menu-icon">💬</text>
          <text class="menu-text">问题反馈</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 管理员菜单 -->
    <view wx:if="{{isAdmin}}" class="menu-card card">
      <view class="menu-item" bindtap="goToNewWordAudit">
        <view class="menu-left">
          <text class="menu-icon">📝</text>
          <text class="menu-text">新词审核</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToCorrectionAudit">
        <view class="menu-left">
          <text class="menu-icon">🔍</text>
          <text class="menu-text">单词审核</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToDefinitionCorrectionAudit">
        <view class="menu-left">
          <text class="menu-icon">📖</text>
          <text class="menu-text">释义审核</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 登录失败 -->
  <view wx:else class="error-state card">
    <view class="error-icon">⚠️</view>
    <text class="error-text">登录失败，请稍后重试</text>
    <button class="btn btn-primary" bindtap="loadData">重试</button>
  </view>
</view>
