<!-- pages/wordlist-add-search/wordlist-add-search.wxml -->
<!-- #014 词单内查词加词：形态复用首页，但底部只有「加入当前词单」一个按钮 -->
<wxs module="helper" src="./helper.wxs"></wxs>

<!-- 自定义导航栏 -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="custom-nav-bar">
    <!-- 详情态：返回按钮先回查词页（与首页一致）；列表态：返回上一页（词单详情） -->
    <view wx:if="{{wordDetail}}" class="nav-back-btn" bindtap="backToResults"></view>
    <view wx:else class="nav-back-btn" bindtap="goBack"></view>
    <text class="nav-title">添加单词</text>
    <view class="nav-placeholder"></view>
  </view>
</view>

<view class="add-search-page" style="padding-top: {{statusBarHeight + 44 + 16}}px;">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-bar">
      <textarea
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="输入日语单词、句子或长文本，如：ありがとう"
        maxlength="2000"
        auto-height
        fixed="{{false}}"
        focus="{{searchAutoFocus}}"
        bindinput="onSearchInput"
        bindconfirm="handleSearch"
      />
      <view class="search-btn" bindtap="handleSearch">查询</view>
    </view>

    <!-- 最近查询 -->
    <view wx:if="{{!wordDetail && searchResults.length === 0 && recentSearches.length > 0}}" class="recent-searches">
      <text class="recent-label">最近查询：</text>
      <text
        wx:for="{{recentSearches}}"
        wx:key="index"
        class="recent-pill"
        data-keyword="{{item}}"
        bindtap="applySearch"
      >{{item}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>查询中...</text>
  </view>

  <!-- 搜索结果列表（复用 home.wxml:50-94） -->
  <view wx:elif="{{searchResults.length > 0 && !wordDetail}}" class="search-results">
    <view class="results-header">
      <text class="results-title">{{isAiResult ? 'AI 查词结果' : '找到 ' + totalResults + ' 个结果'}}</text>
      <view class="clear-btn" bindtap="clearSearch">✕</view>
    </view>
    <view class="results-list">
      <view
        wx:for="{{searchResults}}"
        wx:key="id"
        class="result-item"
        data-index="{{index}}"
        bindtap="selectWord"
      >
        <view class="result-word">
          <view class="result-main jp-text">
            <text wx:for="{{item._kanjiSegments}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
          </view>
          <view wx:if="{{item.word.kanji && item.word.kanji !== item.word.kana}}" class="result-kana jp-text">
            <text wx:for="{{item._kanaSegments}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
          </view>
        </view>
        <view class="result-meaning">
          <text wx:for="{{item._summaryDef._highlightedCn}}" wx:key="index" class="{{item.highlight ? 'highlight-text' : ''}}">{{item.text}}</text>
        </view>
      </view>
    </view>
    <!-- 加载更多按钮 -->
    <view wx:if="{{hasMoreResults}}" class="load-more-btn {{loadingMore ? 'loading' : ''}}" bindtap="loadMoreResults">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:else>加载更多</text>
    </view>
    <view wx:elif="{{searchResults.length > 0}}" class="no-more-hint">
      <text>没有更多结果了</text>
    </view>
    <!-- AI 查词入口（普通结果与 AI 结果下方均显示；详情态隐藏） -->
    <view class="ai-search-entry ai-search-inline {{aiStreaming || aiQueryExhausted ? 'ai-disabled' : ''}}" bindtap="startAiSearch">
      <text wx:if="{{!aiStreaming}}" class="ai-search-icon">✨</text>
      <text wx:else class="ai-search-loading"></text>
      <text class="ai-search-text">{{aiStreaming ? (aiPhaseText || 'AI 查询中...') : (aiQueryExhausted ? 'AI 查词 · 今日次数已用完' : (aiQueryLimit > 0 ? 'AI 查词 · 今日已用 ' + aiQueryUsedToday + ' / ' + aiQueryLimit + ' 次' : 'AI 查词'))}}</text>
    </view>
    <view wx:if="{{aiStatus === 'failed' && aiError}}" class="ai-error">{{aiError}}</view>
  </view>

  <!-- 无搜索结果 + AI 查词 -->
  <view wx:elif="{{showAiSearch}}" class="ai-search-section">
    <view class="ai-search-header">
      <text class="ai-no-result">未找到匹配单词</text>
    </view>
    <view class="ai-search-entry {{aiStreaming || aiQueryExhausted ? 'ai-disabled' : ''}}" bindtap="startAiSearch">
      <text wx:if="{{!aiStreaming}}" class="ai-search-icon">✨</text>
      <text wx:else class="ai-search-loading"></text>
      <text class="ai-search-text">{{aiStreaming ? (aiPhaseText || 'AI 查询中...') : (aiQueryExhausted ? 'AI 查词 · 今日次数已用完' : (aiQueryLimit > 0 ? 'AI 查词 · 今日已用 ' + aiQueryUsedToday + ' / ' + aiQueryLimit + ' 次' : 'AI 查词'))}}</text>
    </view>
    <view wx:if="{{aiStatus === 'failed' && aiError}}" class="ai-error">{{aiError}}</view>
  </view>

  <!-- 单词详情（复用 home.wxml:110-197，去掉更多菜单/纠错/删除/收藏/AI 反馈） -->
  <view wx:elif="{{wordDetail}}" class="word-detail">
    <view class="detail-content card">
      <!-- 单词信息 -->
      <view class="word-info">
        <view class="word-main-row">
          <view class="word-title-wrap">
            <text selectable="{{true}}" class="word-main jp-text">{{wordDetail.word.kanji || wordDetail.word.kana}}</text>
            <text wx:if="{{wordDetail.word.accent !== null && wordDetail.word.accent !== undefined}}" class="word-accent">{{helper.toCircleList(wordDetail.word.accent)}}</text>
          </view>
          <view wx:if="{{wordDetail.wordAudios.length > 0}}" class="audio-btn" data-audio-id="{{wordDetail.wordAudios[0].audioId}}" bindtap="playAudio">
            🔊
          </view>
        </view>
        <text selectable="{{true}}" wx:if="{{wordDetail.word.kanji && wordDetail.word.kanji !== wordDetail.word.kana}}" class="word-kana jp-text">{{wordDetail.word.kana}}</text>
        <view class="word-tags">
          <text wx:if="{{wordDetail.word.jlptLevel}}" class="word-tag">{{wordDetail.word.jlptLevel}}</text>
          <text wx:if="{{wordDetail.word.wordType}}" class="word-tag">{{wordDetail.word.wordType}}</text>
        </view>
      </view>

      <!-- 义项列表 -->
      <view wx:if="{{wordDetail.definitions && wordDetail.definitions.length > 0}}" class="sense-list">
        <view
          wx:for="{{wordDetail.definitions}}"
          wx:key="id"
          wx:for-item="definition"
          wx:for-index="defIndex"
          class="sense-card"
        >
          <view class="sense-header" data-index="{{defIndex}}" bindtap="toggleSense">
            <text class="sense-number">{{defIndex + 1}}</text>
            <view class="sense-header-content">
              <text selectable="{{true}}" class="sense-title">{{definition.definitionCn}}</text>
            </view>
            <text class="sense-toggle {{helper.includes(expandedSense, defIndex) ? 'expanded' : ''}}">▼</text>
          </view>

          <view wx:if="{{helper.includes(expandedSense, defIndex)}}" class="sense-body">
            <!-- 用法说明 -->
            <view wx:if="{{definition.usage}}" class="sense-usage-wrap">
              <text class="usage-label">用法：</text>
              <text selectable="{{true}}" class="sense-usage">{{definition.usage}}</text>
            </view>

            <!-- 例句 -->
            <view wx:if="{{definition.examples && definition.examples.length > 0}}" class="sense-examples">
              <text class="examples-label">例句：</text>
              <view wx:for="{{definition.examples}}" wx:key="id" wx:for-item="example" class="sense-example-item">
                <view class="sense-example-text">
                  <text selectable="{{true}}" class="ex-jp jp-text">{{example.sentenceJp}}</text>
                  <text selectable="{{true}}" wx:if="{{example.sentenceKana}}" class="ex-kana jp-text">{{example.sentenceKana}}</text>
                  <text selectable="{{true}}" class="ex-cn">{{example.sentenceCn}}</text>
                </view>
              </view>
            </view>

            <!-- 注释 -->
            <view wx:if="{{definition.note}}" class="sense-note">
              <text class="note-title">注：</text>
              <text selectable="{{true}}" class="note-body">{{definition.note}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：仅一个全宽主色按钮（UI-05） -->
  <view wx:if="{{wordDetail}}" class="single-action-bar">
    <!-- #014 补漏 UI-05b：该词在当前词单的归属（不在词单/查询失败时整行不渲染） -->
    <view wx:if="{{membership.loaded && membership.inList}}" class="member-tip">
      已在词单<text wx:if="{{membership.groupId}}" class="member-tip-group"> · {{membership.groupName}}</text><text wx:else>（未分组）</text>
    </view>
    <view class="single-action-btn {{submitting ? 'disabled' : ''}}" bindtap="openGroupPicker">加入当前词单</view>
  </view>

  <!-- 空状态（无结果、无详情、无无结果提示时显示） -->
  <view wx:if="{{!loading && searchResults.length === 0 && !showAiSearch && !wordDetail}}" class="empty-lookup">
    <view class="empty-icon">🔍</view>
    <text class="empty-text">输入日语单词开始查询，查不到时可以使用<text class="empty-highlight">AI查词</text>，支持使用汉字、假名、中文意思等配合查询</text>
  </view>

  <!-- ===== 分组选择弹层（UI-06）：对齐首页「加入词单」形态 ===== -->
  <view wx:if="{{showGroupPicker}}" class="picker-ov">
    <view class="picker-mask" bindtap="closeGroupPicker"></view>
    <view class="picker-sheet" catchtap="noop">
      <view class="picker-h">
        <view class="picker-h-main">
          <view class="picker-t">加入词单</view>
          <view class="picker-s">原位置已勾选 · 再点一次可取消</view>
        </view>
        <view class="picker-x" bindtap="closeGroupPicker">✕</view>
      </view>

      <scroll-view class="picker-b" scroll-y="{{true}}">
        <view
          wx:for="{{groupOptions}}"
          wx:key="key"
          wx:for-item="opt"
          class="prow {{groupSelectedKey === opt.key ? 'on' : ''}} {{origGroupKey && opt.key === origGroupKey ? 'cur' : ''}}"
          data-key="{{opt.key}}"
          bindtap="onGroupRowTap"
        >
          <view class="pfolder {{opt.key === '__none_group__' ? 'none' : ''}}">
            <text wx:if="{{opt.key === '__none_group__'}}">📚</text>
          </view>
          <view class="pmain">
            <view class="pname">
              {{opt.name}}<text wx:if="{{origGroupKey && opt.key === origGroupKey}}" class="porig-tag">原位置</text>
            </view>
          </view>
          <view class="pradio {{groupSelectedKey === opt.key ? 'on' : ''}}">
            <text wx:if="{{groupSelectedKey === opt.key}}" class="pradio-tick">✓</text>
          </view>
        </view>
      </scroll-view>

      <view class="picker-f">
        <view wx:if="{{!groupCanConfirm}}" class="picker-hint">当前词单未勾选，确定后将从词单移除该词</view>
        <view class="picker-go {{submitting || !groupCanConfirm ? 'disabled' : ''}}" bindtap="confirmAdd">确定</view>
      </view>
    </view>
  </view>
</view>
